# 存在 .pubignore 时 pub 不再读 .gitignore，下面先抄一份 .gitignore
.dart_tool/
.packages
.pub-cache/
.pub/
build/
pubspec.lock
*.iml
.idea/
coverage/
# accept 运行产物（日志与结果 JSON，可随时重跑生成）
test/accept/*.log
test/accept/results/

# 开发辅助，不随包发布
CLAUDE.md
.claude/
.codegraph/

# 验收证据、归档、覆盖率快照和一次性 Python 脚本只服务仓库内部，不随包发布
/docs/reports/
/docs/archive/
/cov/
/tool/*.py
/docs/
/test/accept/bin/
