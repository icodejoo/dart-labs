   variants = import ../../utils/constants/variants.nix;
+  flavors = import ../../utils/constants/flavors.nix;
   oses = import ../../utils/constants/oses.nix;
+  # mova movaslim-only: mpv v0.41.0's GPU rendering hard-requires libplacebo
