diff --git a/nix/packages/mk-pkg-ffmpeg/default.nix b/nix/packages/mk-pkg-ffmpeg/default.nix
index 060869c..ca762ec 100644
--- a/nix/packages/mk-pkg-ffmpeg/default.nix
+++ b/nix/packages/mk-pkg-ffmpeg/default.nix
@@ -42,16 +42,54 @@ let
     chmod -R 777 $src
 
     cd $src
-    patch -p1 <${../../../patches/ffmpeg-fix-vp9-hwaccel.patch}
-    patch -p1 <${../../../patches/ffmpeg-fix-hls-mp4-seek.patch}
-    patch -p1 <${../../../patches/ffmpeg-fix-ios-hdr-texture.patch}
-    patch -p1 <${../../../patches/ffmpeg-fix-dash-base-url-escape.patch}
+    # These four patches were written against ffmpeg 6.0 (the version this
+    # repo shipped default/full/encodersgpl on before the n9.0 bump below).
+    # movaslim jumps 3 major ffmpeg versions at once — CI run 31361900654
+    # hit a rejected hunk in ffmpeg-fix-hls-mp4-seek.patch against
+    # libavformat/hls.c, which upstream has clearly reworked since 6.0.
+    # Each of these is a targeted runtime
+    # bugfix (VP9 hwaccel edge case / HLS fMP4 seek / iOS HDR texture / DASH
+    # base URL escaping), not something compilation depends on — apply
+    # best-effort (fuzzy, non-fatal) rather than hard-failing the whole
+    # ffmpeg build over one stale hunk. Whichever ones don't apply need to be
+    # re-derived against n9.0 before their underlying bugs matter again;
+    # `*.rej` files are copied into $out below so that's diffable later
+    # instead of silently lost.
+    #
+    # ffmpeg-fix-vp9-hwaccel.patch is excluded entirely (not just
+    # best-effort) — CI run 31364922391 showed it's not a "rejected hunk"
+    # case like the others: it applies cleanly (fuzzy-matched) but the
+    # standalone `ff_vp9_videotoolbox_decoder` it adds to libavcodec/vp9.c
+    # references `FF_CODEC_CAP_ALLOCATE_PROGRESS`, an internal capability
+    # flag that doesn't exist in ffmpeg n9.0 — a hard compile error, not a
+    # skippable runtime-bugfix gap. It's also not needed here regardless:
+    # this patch's `vp9_videotoolbox` is a standalone decoder (mirroring
+    # MediaCodec's pattern), but movaslim's video_movaslim_options never
+    # enables that decoder — VP9 hardware acceleration here goes through
+    # `--enable-hwaccel=vp9_videotoolbox` layered on top of the plain `vp9`
+    # software decoder instead (see mk-pkg-ffmpeg/meson.build's movaslim
+    # branch comments on why VP9 can't go hw-only the way Android does).
+    for p in \
+      ${../../../patches/ffmpeg-fix-hls-mp4-seek.patch} \
+      ${../../../patches/ffmpeg-fix-ios-hdr-texture.patch} \
+      ${../../../patches/ffmpeg-fix-dash-base-url-escape.patch} \
+    ; do
+      if patch -p1 --fuzz=5 <"$p"; then
+        echo "applied: $p"
+      else
+        echo "::warning:: could not fully apply $p against ffmpeg ${version} — see *.rej"
+      fi
+    done
     cd -
 
     cp ${./meson.build} $src/meson.build
     cp ${./meson.options} $src/meson.options
 
     cp -r $src $out
+    # Nix's sandbox only allows writes under $out/$TMPDIR, so rejects can't
+    # be shipped as a separate output — just dump them to the build log
+    # (visible in CI) instead of losing them silently.
+    find $src -name '*.rej' -exec sh -c 'echo "--- $1 ---"; cat "$1"' _ {} \; || true
   '';
 in
 
diff --git a/nix/packages/mk-pkg-ffmpeg/meson.build b/nix/packages/mk-pkg-ffmpeg/meson.build
index 1b8afa3..83a05da 100644
--- a/nix/packages/mk-pkg-ffmpeg/meson.build
+++ b/nix/packages/mk-pkg-ffmpeg/meson.build
@@ -283,6 +283,136 @@ video_full_options = [
     '--enable-decoder=h264',
 ]
 
+# mova slim flavor — mirrors mova/tools/ffmpeg-slim/flavors-mova-slim.sh
+# (the Android decoder/demuxer/protocol keep-list from
+# mova/doc/notes/2026-07-31-ffmpeg-slimming-options.md), adapted to this
+# platform: no MediaCodec-style separate hw decoder namespace here, so
+# VideoToolbox is a hwaccel layered on top of the plain software decoder
+# (h264/hevc/vp9 stay enabled as decoders; VideoToolbox is opportunistic).
+# AV1 has no VideoToolbox hwaccel in ffmpeg's hwaccel list on this platform,
+# so it's libdav1d software-only (same decoder Android uses as its AV1
+# fallback path). Legacy formats (VP8/MJPEG/MPEG-1/2/4/H.263/WMV/etc.) and
+# DASH (needs libxml2, ~740KB, not enabled here) are dropped, matching the
+# Android keep-list. Filters stay empty (no overlay/equalizer) — Android
+# real-device testing (2026-08-10) confirmed OSD/subtitle compositing has no
+# regression without them, since mpv's own scale/format conversion goes
+# through swscale/swresample directly, not lavfi.
+audio_movaslim_options = [
+    # decoders
+    '--enable-decoder=aac*',
+    '--enable-decoder=ac3',
+    '--enable-decoder=eac3',
+    '--enable-decoder=flac',
+    '--enable-decoder=mp3*',
+    '--enable-decoder=opus',
+    '--enable-decoder=pcm_s16le',
+    '--enable-decoder=pcm_s16be',
+    '--enable-decoder=pcm_s24le',
+    '--enable-decoder=pcm_s32le',
+    '--enable-decoder=pcm_f32le',
+    '--enable-decoder=pcm_u8',
+    '--enable-decoder=vorbis',
+
+    # parsers
+    '--enable-parser=aac*',
+    '--enable-parser=ac3',
+    '--enable-parser=flac',
+    '--enable-parser=mpegaudio',
+    '--enable-parser=vorbis',
+
+    # demuxers
+    '--enable-demuxer=aac',
+    '--enable-demuxer=ac3',
+    '--enable-demuxer=eac3',
+    '--enable-demuxer=flac',
+    '--enable-demuxer=mp3',
+    '--enable-demuxer=ogg',
+    '--enable-demuxer=wav',
+
+    # protocols — kept here regardless of variant, mirroring how the
+    # `default`/`full` flavors above always source protocols off the
+    # audio_*_options list even when variant == video.
+    '--enable-protocol=crypto', # HLS AES-128 encrypted segments
+    '--enable-protocol=data',
+    '--enable-protocol=ffrtmpcrypt',
+    '--enable-protocol=ffrtmphttp',
+    '--enable-protocol=file',
+    '--enable-protocol=hls',
+    '--enable-protocol=http',
+    '--enable-protocol=https',
+    '--enable-protocol=pipe',
+    '--enable-protocol=rtmp',
+    '--enable-protocol=rtmps',
+    '--enable-protocol=rtmpt',
+    '--enable-protocol=rtmpts',
+    '--enable-protocol=rtp',
+    '--enable-protocol=tcp',
+    '--enable-protocol=tls',
+    '--enable-protocol=udp',
+]
+
+video_movaslim_options = [
+    # decoders
+    '--enable-decoder=h264',
+    '--enable-decoder=hevc',
+    '--enable-decoder=vp9', # software decoder — VideoToolbox's vp9 hwaccel
+                             # wraps this rather than replacing it, unlike
+                             # Android's separate vp9_mediacodec decoder
+    '--enable-decoder=libdav1d', # av1, software-only on this platform
+    '--enable-decoder=png', # cover art / mpv screenshot command
+
+    '--enable-decoder=ass',
+    '--enable-decoder=ssa',
+    '--enable-decoder=subrip',
+    '--enable-decoder=text',
+    '--enable-decoder=webvtt',
+    '--enable-decoder=movtext',
+
+    # parsers
+    '--enable-parser=h264',
+    '--enable-parser=hevc',
+    '--enable-parser=vp9',
+    '--enable-parser=av1',
+    '--enable-parser=png',
+
+    # demuxers
+    '--enable-demuxer=mov',
+    '--enable-demuxer=matroska',
+    '--enable-demuxer=webm_dash_manifest',
+    '--enable-demuxer=mpegts',
+    '--enable-demuxer=hls',
+    '--enable-demuxer=flv',
+    '--enable-demuxer=live_flv',
+    '--enable-demuxer=data',
+    '--enable-demuxer=ass',
+    '--enable-demuxer=srt',
+    '--enable-demuxer=webvtt',
+
+    # hwaccels — only the codecs we actually decode get a hwaccel entry
+    '--enable-hwaccel=h264_videotoolbox',
+    '--enable-hwaccel=hevc_videotoolbox',
+    '--enable-hwaccel=vp9_videotoolbox',
+
+    # bitstream filters — needed for HLS TS<->MP4 NAL format conversion and
+    # AV1/VP9 superframe splitting; `--disable-all` zeroes bsfs same as
+    # decoders/demuxers, so these need explicit enabling (the `default`
+    # flavor above never does this and ends up with the full bsf set,
+    # since only `full`/`encodersgpl` call `--enable-bsfs` explicitly —
+    # movaslim opts into a minimal explicit list instead of either extreme)
+    '--enable-bsf=h264_mp4toannexb',
+    '--enable-bsf=hevc_mp4toannexb',
+    '--enable-bsf=aac_adtstoasc',
+    '--enable-bsf=vp9_superframe',
+    '--enable-bsf=vp9_superframe_split',
+    '--enable-bsf=av1_frame_split',
+    '--enable-bsf=av1_frame_merge',
+    '--enable-bsf=mov2textsub',
+    '--enable-bsf=extract_extradata',
+    '--enable-bsf=dump_extradata',
+    '--enable-bsf=setts',
+    '--enable-bsf=null',
+]
+
 audio_encodersgpl_options = [
     '--enable-encoders',
     '--enable-muxers',
@@ -325,6 +455,11 @@ elif flavor == 'encodersgpl'
         options += video_full_options
         options += video_encodersgpl_options
     endif
+elif flavor == 'movaslim'
+    options += audio_movaslim_options
+    if variant == 'video'
+        options += video_movaslim_options
+    endif
 endif
 
 p = mod.add_project('configure',
