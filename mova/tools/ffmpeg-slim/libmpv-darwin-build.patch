+# Static, not shared — links ffmpeg's components straight into libmpv.dylib
+# (mirroring Android's shipped approach: one file, not this repo's default
+# N-separate-dylibs shape) so the final link step's dead-code elimination
+# can actually see across what used to be library boundaries. Applied
+# unconditionally (not just for movaslim) since nothing in this repo's CI
+# builds the other flavors regardless (see packages.lock.nix's version-bump
+# comments) — every other dependency package gets this same unconditional
+# static switch, to avoid threading a flavor/os check through every leaf
+# package individually.
+options += ['--enable-static', '--disable-shared']
+
+# stdenvNoCC's external_project configure subprocess doesn't inherit the
+# derivation's PKG_CONFIG_PATH env var (same gap fixed for AR above) —
+# thread it through explicitly via a meson option instead.
+ffmpeg_pkg_config_path = get_option('ffmpeg_pkg_config_path')
+message('DEBUG ffmpeg_pkg_config_path = "@0@"'.format(ffmpeg_pkg_config_path))
+
+p = mod.add_project('configure',
+    configure_options : options,
+    env : ffmpeg_pkg_config_path != '' ? {'PKG_CONFIG_PATH': ffmpeg_pkg_config_path} : {},
+    cross_configure_options: [
+        '--enable-cross-compile',
+        '--target-os=@0@'.format(host_machine.system()),
+        '--arch=@0@'.format(host_machine.cpu_family()),
+
+        '--nm=@0@'.format(nm.path()),
+        '--ar=@0@'.format(ar.path()),
+        '--as=@0@'.format(''.join(c.cmd_array())),
+        '--strip=@0@'.format(strip.path()),
+        '--cc=@0@'.format(''.join(c.cmd_array())),
+        '--cxx=@0@'.format(''.join(cpp.cmd_array())),
+        '--objcc=@0@'.format(''.join(objc.cmd_array())),
+        '--ld=@0@'.format(''.join(c.cmd_array())),
+        '--pkg-config=@0@'.format(pkg_config.path()),
+
+        '--host-cc=@0@'.format(''.join(c.cmd_array())),
+        '--host-ld=@0@'.format(''.join(c.cmd_array())),
+
+        '--extra-cflags=@0@'.format(' '.join(c_args)),
+        '--extra-cxxflags=@0@'.format(' '.join(cpp_args)),
+        '--extra-objcflags=@0@'.format(' '.join(objc_args)),
+        '--extra-ldflags=@0@'.format(' '.join(c_link_args)),
+    ],
+    verbose: true,
+)
+
+libavfilter_dep = p.dependency('avfilter')
+libswscale_dep = p.dependency('swscale')
+libavcodec_dep = p.dependency('avcodec')
+libavformat_dep = p.dependency('avformat')
+libavutil_dep = p.dependency('avutil')
+libswresample_dep = p.dependency('swresample')
+
+meson.override_dependency('libavfilter', libavfilter_dep)
+meson.override_dependency('libswscale', libswscale_dep)
+meson.override_dependency('libavcodec', libavcodec_dep)
+meson.override_dependency('libavformat', libavformat_dep)
