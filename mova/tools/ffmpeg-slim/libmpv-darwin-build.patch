+       description: 'Platform-appropriate -mmacosx-version-min/-miphoneos-version-min flag, computed in Nix (default.nix) since it depends on os, which meson cross-files here do not expose (host_machine.system() is "darwin" for macOS/iOS/iossimulator alike)')
diff --git a/nix/packages/mk-pkg-libplacebo/default.nix b/nix/packages/mk-pkg-libplacebo/default.nix
new file mode 100644
index 0000000..fb2a8c7
--- /dev/null
+++ b/nix/packages/mk-pkg-libplacebo/default.nix
@@ -0,0 +1,160 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+}:
+
+let
+  name = "libplacebo";
+  lock = import ../../../packages.lock.nix;
+  packageLock = lock.${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch; };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+  xctoolchainLipo = callPackage ../../utils/xctoolchain/lipo.nix { };
+  glslang = callPackage ../mk-pkg-glslang/default.nix { };
+  vulkanHeaders = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "vulkan-headers-source-${lock.vulkanHeaders.version}";
+    inherit (lock.vulkanHeaders) url sha256;
+  };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+
+  # GitHub's tag archive (unlike `git clone --recursive`, which is what
+  # tools/ffmpeg-slim/experiments/build-{android,win}-libmpv-v9.sh use) does
+  # not include submodule content — fetch each submodule libplacebo's core
+  # build actually needs (not demos/nuklear or Vulkan-Headers, both unused
+  # here: -Ddemos=false, -Dvulkan=disabled) at the exact commit pinned by
+  # v7.351.0's .gitmodules, and splice them into place.
+  jinja = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-jinja-source-${lock.libplaceboJinja.version}";
+    inherit (lock.libplaceboJinja) url sha256;
+  };
+  markupsafe = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-markupsafe-source-${lock.libplaceboMarkupsafe.version}";
+    inherit (lock.libplaceboMarkupsafe) url sha256;
+  };
+  fastFloat = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-fast-float-source-${lock.libplaceboFastFloat.version}";
+    inherit (lock.libplaceboFastFloat) url sha256;
+  };
+  glad = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-glad-source-${lock.libplaceboGlad.version}";
+    inherit (lock.libplaceboGlad) url sha256;
+  };
+
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    cp -r ${src} $out
+    chmod -R u+w $out
+
+    rm -rf $out/3rdparty/jinja $out/3rdparty/markupsafe $out/3rdparty/fast_float $out/3rdparty/glad
+    cp -r ${jinja} $out/3rdparty/jinja
+    cp -r ${markupsafe} $out/3rdparty/markupsafe
+    cp -r ${fastFloat} $out/3rdparty/fast_float
+    cp -r ${glad} $out/3rdparty/glad
+    chmod -R u+w $out/3rdparty
+
+    # Same underlying gap tools/ffmpeg-slim/experiments/build-android-
+    # libmpv-v9.sh works around by hand: cc.has_header('glslang/build_info.h')
+    # is called with no -I args, so it can't see glslang's include dir even
+    # though it's on CPATH (has_header()'s implicit include search doesn't
+    # extend to CPATH the way an actual compile does). That script points it
+    # at a '-Dvulkan-sdk=...' meson option value — but v7.351.0 (the version
+    # pinned here) doesn't have a 'vulkan-sdk' option at all (CI run
+    # 31362842554: "ERROR: Unknown options: vulkan-sdk" — that option must
+    # have been added to libplacebo's meson_options.txt sometime after this
+    # tag; the Android/Windows scripts float on an unpinned `git clone`, so
+    # they never hit this gap). Bake the real path in directly instead of
+    # round-tripping through a meson option that doesn't exist here.
+    sed -i "s|cc.has_header('glslang/build_info.h')|cc.has_header('glslang/build_info.h', args: ['-I${glslang}/include'])|" \
+      $out/src/glsl/meson.build
+
+    # CPATH/LIBRARY_PATH (set as env vars on the outer derivation below) get
+    # this has_header() fix's job done for compiling, but CI run
+    # 31363239642 showed find_library() doesn't extend the same courtesy on
+    # macOS: "Library SPIRV found: NO" even with LIBRARY_PATH pointed right
+    # at it. This isn't the same CPATH/LIBRARY_PATH gap the Android/Windows
+    # scripts hit (those platforms' GNU-style linkers DO honor
+    # LIBRARY_PATH) — Apple's ld64/clang driver simply doesn't consult
+    # LIBRARY_PATH for `-l` search the way GNU toolchains do, full stop.
+    # meson's find_library() has a proper `dirs:` kwarg for exactly this
+    # (extra search directories, independent of the platform linker's own
+    # env-var conventions) — inject it on every cxx.find_library('NAME', ...)
+    # call in this file (glslang-default-resource-limits/SPIRV/glslang/
+    # MachineIndependent/OSDependent/GenericCodeGen/OGLCompiler etc.) rather
+    # than fighting the platform difference via environment variables.
+    sed -i -E "s|cxx\.find_library\('([a-zA-Z0-9_-]+)'|cxx.find_library('\1', dirs: ['${glslang}/lib']|g" \
+      $out/src/glsl/meson.build
+  '';
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+    pkgs.python3
+    # meson's find_library() shells out to the bare `lipo` command (see
+    # nix/utils/xctoolchain/lipo.nix's comment — it doesn't use
+    # find_program()) to check a candidate library's architecture; without
+    # this on PATH, CI run 31363805395 died with a raw Python
+    # FileNotFoundError as soon as find_library() actually located
+    # glslang's .a files (progress from the previous "not found" error, not
+    # a regression — mk-pkg-mpv/mk-out-libs already carry this same
+    # nativeBuildInput for the same reason).
+    xctoolchainLipo
+  ];
+  # meson's cc.find_library()/cc.has_header() (used by libplacebo's
+  # src/glsl/meson.build to locate glslang — it isn't a proper pkg-config
+  # dependency(), see mk-pkg-glslang's meson.build comment) does a compiler
+  # trial-link/header-search rather than a PKG_CONFIG_PATH lookup, so it
+  # only sees glslang's headers/libs via the compiler's own implicit search
+  # paths. clang (like gcc) honors CPATH/LIBRARY_PATH for this — same
+  # mechanism the shell experiments rely on (see their headers' comments on
+  # this exact gap).
+  # vulkanHeaders: libplacebo's public src/include/libplacebo/vulkan.h
+  # unconditionally #includes <vulkan/vulkan.h> for its type declarations —
+  # even src/vulkan/stubs.c (the no-op backend built when -Dvulkan=disabled)
+  # pulls it in transitively, so real Vulkan headers are needed at compile
+  # time regardless of whether the Vulkan backend itself is enabled (CI run
+  # 31364298402: "fatal error: 'vulkan/vulkan.h' file not found"). Unlike
+  # the has_header()/find_library() special-casing above, this is a plain
+  # `clang -c ...` compile, so CPATH is genuinely honored here (CPATH is a
+  # C-preprocessor/frontend convention clang follows directly — the
+  # LIBRARY_PATH gap below is specifically about Apple's ld64 linker `-l`
+  # search, an unrelated mechanism).
+  CPATH = "${glslang}/include:${vulkanHeaders}/include";
+  LIBRARY_PATH = "${glslang}/lib";
+  configurePhase = ''
+    meson setup build $src \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out \
+      --default-library=static \
+      -Dvulkan=disabled \
+      -Dopengl=enabled \
+      -Dd3d11=disabled \
+      -Dglslang=enabled \
+      -Dshaderc=disabled \
+      -Ddemos=false \
+      -Dtests=false
+  '';
+  buildPhase = ''
+    meson compile -vC build
+  '';
+  installPhase = ''
+    meson install -C build
+  '';
+}
