+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+  variant ? import ../../utils/default/variant.nix,
+  flavor ? import ../../utils/default/flavor.nix,
+}:
+
+let
+  name = "ffmpeg";
+  packageLock = (import ../../../packages.lock.nix).${name};
+  inherit (packageLock) version;
+
+  flavors = import ../../utils/constants/flavors.nix;
+  variants = import ../../utils/constants/variants.nix;
+  callPackage = pkgs.lib.callPackageWith {
+    inherit
+      pkgs
+      os
+      arch
+      variant
+      flavor
+      ;
+  };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+  mbedtls = callPackage ../mk-pkg-mbedtls/default.nix { };
+  dav1d = callPackage ../mk-pkg-dav1d/default.nix { };
+  libxml2 = callPackage ../mk-pkg-libxml2/default.nix { };
+  libvorbis = callPackage ../mk-pkg-libvorbis/default.nix { };
+  libvpx = callPackage ../mk-pkg-libvpx/default.nix { };
+  libx264 = callPackage ../mk-pkg-libx264/default.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    cp -r ${src} src
+    export src=$PWD/src
+    chmod -R 777 $src
+
+    cd $src
+    # These four patches were written against ffmpeg 6.0 (the version this
+    # repo shipped default/full/encodersgpl on before the n9.0 bump below).
+    # movaslim jumps 3 major ffmpeg versions at once — CI run 31361900654
+    # hit a rejected hunk in ffmpeg-fix-hls-mp4-seek.patch against
+    # libavformat/hls.c, which upstream has clearly reworked since 6.0.
+    # Each of these is a targeted runtime
+    # bugfix (VP9 hwaccel edge case / HLS fMP4 seek / iOS HDR texture / DASH
+    # base URL escaping), not something compilation depends on — apply
+    # best-effort (fuzzy, non-fatal) rather than hard-failing the whole
+    # ffmpeg build over one stale hunk. Whichever ones don't apply need to be
+    # re-derived against n9.0 before their underlying bugs matter again;
+    # `*.rej` files are copied into $out below so that's diffable later
+    # instead of silently lost.
+    #
+    # ffmpeg-fix-vp9-hwaccel.patch is excluded entirely (not just
+    # best-effort) — CI run 31364922391 showed it's not a "rejected hunk"
+    # case like the others: it applies cleanly (fuzzy-matched) but the
+    # standalone `ff_vp9_videotoolbox_decoder` it adds to libavcodec/vp9.c
+    # references `FF_CODEC_CAP_ALLOCATE_PROGRESS`, an internal capability
+    # flag that doesn't exist in ffmpeg n9.0 — a hard compile error, not a
+    # skippable runtime-bugfix gap. It's also not needed here regardless:
+    # this patch's `vp9_videotoolbox` is a standalone decoder (mirroring
+    # MediaCodec's pattern), but movaslim's video_movaslim_options never
+    # enables that decoder — VP9 hardware acceleration here goes through
+    # `--enable-hwaccel=vp9_videotoolbox` layered on top of the plain `vp9`
+    # software decoder instead (see mk-pkg-ffmpeg/meson.build's movaslim
+    # branch comments on why VP9 can't go hw-only the way Android does).
+    for p in \
+      ${../../../patches/ffmpeg-fix-hls-mp4-seek.patch} \
+      ${../../../patches/ffmpeg-fix-ios-hdr-texture.patch} \
+      ${../../../patches/ffmpeg-fix-dash-base-url-escape.patch} \
+    ; do
+      if patch -p1 --fuzz=5 <"$p"; then
+        echo "applied: $p"
+      else
+        echo "::warning:: could not fully apply $p against ffmpeg ${version} — see *.rej"
+      fi
+    done
+    cd -
+
+    cp ${./meson.build} $src/meson.build
+    cp ${./meson.options} $src/meson.options
+
+    cp -r $src $out
+    # Nix's sandbox only allows writes under $out/$TMPDIR, so rejects can't
+    # be shipped as a separate output — just dump them to the build log
+    # (visible in CI) instead of losing them silently.
+    find $src -name '*.rej' -exec sh -c 'echo "--- $1 ---"; cat "$1"' _ {} \; || true
+  '';
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${variant}-${flavor}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+  ];
+  buildInputs =
+    [ mbedtls ]
+    ++ pkgs.lib.optionals (flavor == flavors.encodersgpl) [
+      libvorbis
+    ]
+    ++ pkgs.lib.optionals (variant == variants.video) [
+      dav1d
+      libxml2
+    ]
+    ++ pkgs.lib.optionals (variant == variants.video && flavor == flavors.encodersgpl) [
+      libvpx
+      libx264
+    ];
+  # CI runs 31379586940/31380265939 (reproducible, not a caching fluke):
+  # "ERROR: libxml-2.0 not found using pkg-config" from ffmpeg's own
+  # ./configure, despite libxml2 building and installing libxml-2.0.pc
+  # successfully in the same run. mbedtls/dav1d don't hit this (ffmpeg's
+  # configure likely checks them via a non-pkg-config path), which is why
+  # only libxml2's check surfaces it. This package uses
+  # `stdenvNoCC.mkDerivation` (no C compiler wrapper) — pkg-config's usual
+  # "auto-populate PKG_CONFIG_PATH from buildInputs" setup-hook may not
+  # engage the same way it does under full stdenv, and every prior success
+  # happened to have libxml2 already cache-hit from an earlier run rather
+  # than freshly built in the same session, which likely papered over this
+  # rather than actually exercising the propagation path. Set it
+  # explicitly instead of relying on that implicit mechanism.
+  PKG_CONFIG_PATH = pkgs.lib.concatStringsSep ":" (
+    map (dep: "${dep}/lib/pkgconfig") ([ mbedtls ] ++ pkgs.lib.optionals (variant == variants.video) [ dav1d libxml2 ])
+  );
+  configurePhase = ''
+    echo "DEBUG PKG_CONFIG_PATH=$PKG_CONFIG_PATH"
+    echo "DEBUG which pkg-config: $(command -v pkg-config)"
+    pkg-config --exists --print-errors libxml-2.0 && echo "DEBUG raw pkg-config: FOUND" || echo "DEBUG raw pkg-config: NOT FOUND"
+    pkg-config --cflags --libs libxml-2.0 || true
+    meson setup build $src \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out \
+      -Dvariant=${variant} \
+      -Dflavor=${flavor} \
+      -Dffmpeg_pkg_config_path="$PKG_CONFIG_PATH" |
+      tee configure.log
+  '';
+  buildPhase = ''
+    meson compile -vC build $(basename $src)
+  '';
+  installPhase = ''
+    # manual install to preserve symlinks (meson install -C build)
+    cp -r build/dist$out $out
+
+    # copy configure.log
+    cp configure.log $out/share/ffmpeg/
+  '';
+}
