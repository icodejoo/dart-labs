diff --git a/nix/packages/mk-pkg-glslang/default.nix b/nix/packages/mk-pkg-glslang/default.nix
new file mode 100644
index 0000000..d4a6a33
--- /dev/null
+++ b/nix/packages/mk-pkg-glslang/default.nix
@@ -0,0 +1,81 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+}:
+
+let
+  name = "glslang";
+  packageLock = (import ../../../packages.lock.nix).${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch; };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    mkdir -p $out/subprojects/glslang
+    cp -r ${src}/* $out/subprojects/glslang/
+    cp ${./meson.build} $out/meson.build
+  '';
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.cmake
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+    pkgs.python3
+  ];
+  configurePhase = ''
+    meson setup build $src \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out
+  '';
+  buildPhase = ''
+    meson compile -vC build
+  '';
+  installPhase = ''
+    mkdir -p $out/lib $out/include
+
+    # Static libs — glslang's CMake exports several separate targets
+    # (glslang/MachineIndependent/GenericCodeGen/OSDependent/OGLCompiler/
+    # SPIRV), all landing somewhere under the meson-driven cmake.subproject
+    # build tree. Glob broadly rather than hardcoding exact subdirectory
+    # names, which vary by glslang/CMake version.
+    find build -type f -name '*.a' -exec cp -n {} $out/lib/ \;
+
+    # Headers — public API headers live in the source tree
+    # (glslang/Public, glslang/Include, SPIRV, StandAlone); build_info.h is
+    # CMake-generated at configure time into the build tree. Copy both,
+    # preserving the glslang/SPIRV/StandAlone include-path structure
+    # libplacebo's src/glsl/meson.build expects (glslang/..., SPIRV/...).
+    src_root=$(find build/subprojects -maxdepth 1 -type d -name 'glslang*' | head -1)
+    if [ -z "$src_root" ]; then src_root=$src/subprojects/glslang; fi
+
+    for d in glslang SPIRV StandAlone; do
+      if [ -d "$src_root/$d" ]; then
+        mkdir -p "$out/include/$d"
+        find "$src_root/$d" -name '*.h' -exec cp --parents -t $out/include {} \; 2>/dev/null || true
+      fi
+    done
+    # Generated build_info.h (and any other configure-time generated
+    # headers) — search the whole build tree, not just src_root, since
+    # CMake typically places generated files under the binary dir mirroring
+    # the source's relative path, not inside the source tree itself.
+    find build -name 'build_info.h' -exec cp {} $out/include/glslang/ \; 2>/dev/null || true
+  '';
+}
diff --git a/nix/packages/mk-pkg-glslang/meson.build b/nix/packages/mk-pkg-glslang/meson.build
new file mode 100644
index 0000000..afe9aba
--- /dev/null
+++ b/nix/packages/mk-pkg-glslang/meson.build
@@ -0,0 +1,67 @@
+# glslang ships CMake, not meson — wrapped via meson's cmake module the same
+# way mk-pkg-mbedtls wraps mbedtls's own CMake build (see that package's
+# meson.build for the reference pattern this mirrors). The outer Nix
+# derivation's installPhase globs the resulting .a files out of `build/`
+# directly (same approach mbedtls's installPhase uses for its .dylib) rather
+# than wiring a meson dependency() object — libplacebo's own src/glsl/
+# meson.build looks glslang up via raw cc.find_library()/cc.has_header()
+# calls, not a pkg-config dependency, so there is nothing here that needs to
+# go through meson.override_dependency().
+#
+# Flags mirror tools/ffmpeg-slim/experiments/build-{android,win}-libmpv-v9.sh's
+# glslang cmake invocation: ENABLE_OPT=OFF drops the SPIR-V optimizer
+# (SPIRV-Tools-opt, the single biggest non-ffmpeg static-lib piece in those
+# experiments — libplacebo's shaders are hand-written and small, not codegen
+# output that benefits from an optimization pass) and
+# ALLOW_EXTERNAL_SPIRV_TOOLS=OFF keeps glslang from reaching for a system
+# SPIRV-Tools this sandboxed build doesn't provide.
+project('glslang', 'c', 'cpp')
+
+cmake = import('cmake')
+
+cpu = host_machine.cpu()
+if cpu == 'amd64'
+    arch = 'x86_64'
+elif cpu == 'arm64'
+    arch = 'arm64'
+endif
+
+# glslang's GenericCodeGen/Include/InfoSink.h uses std::filesystem::path
+# (macOS 10.15+), but this repo's cross-files/*.ini bakes a blanket
+# -mmacosx-version-min=10.9 into every package's c_args/cpp_args (kept low
+# for the amd64/universal builds' compatibility floor) — that leaks into
+# glslang's CMake subproject and clang's availability annotations turn
+# every std::filesystem call into a hard "unavailable" compile error at
+# 10.9. Raising just glslang's deployment target (not the shared
+# cross-file, which every other package still needs at 10.9) fixes it
+# without touching anything else's compatibility floor. 10.15 is the
+# minimum std::filesystem needs; arm64 Macs never shipped below 11.0
+# anyway so this costs nothing in practice for the macos-arm64 target
+# movaslim is being validated on first.
+options = cmake.subproject_options()
+options.add_cmake_defines({
+    'CMAKE_OSX_ARCHITECTURES': arch,
+    'CMAKE_OSX_SYSROOT': meson.get_cross_property('cmake_osx_sysroot'),
+    'CMAKE_OSX_DEPLOYMENT_TARGET': '10.15',
+    'CMAKE_C_FLAGS': '-mmacosx-version-min=10.15',
+    'CMAKE_CXX_FLAGS': '-mmacosx-version-min=10.15',
+    'CMAKE_C_COMPILER_WORKS': true,
+    'CMAKE_CXX_COMPILER_WORKS': true,
+    'CMAKE_BUILD_TYPE': 'Release',
+    'BUILD_SHARED_LIBS': false,
+    'ENABLE_GLSLANG_BINARIES': false,
+    'ENABLE_SPVREMAPPER': false,
+    'ENABLE_CTEST': false,
+    'ENABLE_HLSL': false,
+    'ALLOW_EXTERNAL_SPIRV_TOOLS': false,
+    'ENABLE_OPT': false,
+})
+
+# Referencing .dependency('glslang') below is what forces meson to actually
+# configure+build the subproject (evaluating it is not lazy) even though
+# nothing in this wrapper links against it — the outer Nix installPhase
+# harvests the resulting .a files straight out of the meson build directory
+# instead (see comment above).
+glslang_proj = cmake.subproject('glslang', options: options)
+glslang_dep = glslang_proj.dependency('glslang')
+
diff --git a/nix/packages/mk-pkg-libplacebo/default.nix b/nix/packages/mk-pkg-libplacebo/default.nix
new file mode 100644
index 0000000..5b71daa
--- /dev/null
+++ b/nix/packages/mk-pkg-libplacebo/default.nix
@@ -0,0 +1,115 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+}:
+
+let
+  name = "libplacebo";
+  lock = import ../../../packages.lock.nix;
+  packageLock = lock.${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch; };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+  glslang = callPackage ../mk-pkg-glslang/default.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+
+  # GitHub's tag archive (unlike `git clone --recursive`, which is what
+  # tools/ffmpeg-slim/experiments/build-{android,win}-libmpv-v9.sh use) does
+  # not include submodule content — fetch each submodule libplacebo's core
+  # build actually needs (not demos/nuklear or Vulkan-Headers, both unused
+  # here: -Ddemos=false, -Dvulkan=disabled) at the exact commit pinned by
+  # v7.351.0's .gitmodules, and splice them into place.
+  jinja = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-jinja-source-${lock.libplaceboJinja.version}";
+    inherit (lock.libplaceboJinja) url sha256;
+  };
+  markupsafe = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-markupsafe-source-${lock.libplaceboMarkupsafe.version}";
+    inherit (lock.libplaceboMarkupsafe) url sha256;
+  };
+  fastFloat = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-fast-float-source-${lock.libplaceboFastFloat.version}";
+    inherit (lock.libplaceboFastFloat) url sha256;
+  };
+  glad = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-glad-source-${lock.libplaceboGlad.version}";
+    inherit (lock.libplaceboGlad) url sha256;
+  };
+
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    cp -r ${src} $out
+    chmod -R u+w $out
+
+    rm -rf $out/3rdparty/jinja $out/3rdparty/markupsafe $out/3rdparty/fast_float $out/3rdparty/glad
+    cp -r ${jinja} $out/3rdparty/jinja
+    cp -r ${markupsafe} $out/3rdparty/markupsafe
+    cp -r ${fastFloat} $out/3rdparty/fast_float
+    cp -r ${glad} $out/3rdparty/glad
+    chmod -R u+w $out/3rdparty
+
+    # Same fix tools/ffmpeg-slim/experiments/build-android-libmpv-v9.sh
+    # applies by hand: cc.has_header('glslang/build_info.h') is called with
+    # no -I args, so it can't see glslang's include dir even though it's on
+    # CPATH (has_header()'s implicit--I search doesn't extend to CPATH the
+    # way an actual compile does) — pass it explicitly via the
+    # already-present -Dvulkan-sdk option (repurposed by libplacebo's own
+    # src/glsl/meson.build to point glslang lookups at a prefix, see that
+    # file upstream), same as the Android/Windows experiments do.
+    sed -i "s|cc.has_header('glslang/build_info.h')|cc.has_header('glslang/build_info.h', args: ['-I' + get_option('vulkan-sdk') / 'include'])|" \
+      $out/src/glsl/meson.build
+  '';
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+    pkgs.python3
+  ];
+  # meson's cc.find_library()/cc.has_header() (used by libplacebo's
+  # src/glsl/meson.build to locate glslang — it isn't a proper pkg-config
+  # dependency(), see mk-pkg-glslang's meson.build comment) does a compiler
+  # trial-link/header-search rather than a PKG_CONFIG_PATH lookup, so it
+  # only sees glslang's headers/libs via the compiler's own implicit search
+  # paths. clang (like gcc) honors CPATH/LIBRARY_PATH for this — same
+  # mechanism the shell experiments rely on (see their headers' comments on
+  # this exact gap).
+  CPATH = "${glslang}/include";
+  LIBRARY_PATH = "${glslang}/lib";
+  configurePhase = ''
+    meson setup build $src \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out \
+      --default-library=static \
+      -Dvulkan=disabled \
+      -Dopengl=enabled \
+      -Dd3d11=disabled \
+      -Dglslang=enabled \
+      -Dshaderc=disabled \
+      -Ddemos=false \
+      -Dtests=false \
+      -Dvulkan-sdk=${glslang}
+  '';
+  buildPhase = ''
+    meson compile -vC build
+  '';
+  installPhase = ''
+    meson install -C build
+  '';
+}
diff --git a/nix/packages/mk-pkg-mpv/default.nix b/nix/packages/mk-pkg-mpv/default.nix
index 543805a..3242724 100644
--- a/nix/packages/mk-pkg-mpv/default.nix
