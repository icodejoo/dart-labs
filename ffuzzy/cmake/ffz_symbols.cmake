# 可定位配置保留库内符号，其余配置生成独立符号文件并压缩库。
string(TOUPPER "${FFZ_CONFIG}" FFZ_CONFIG_UPPER)
if(FFZ_CONFIG_UPPER MATCHES "^(DEBUG|PROFILE|RELWITHDEBINFO)$")
  return()
endif()
execute_process(COMMAND "${FFZ_OBJCOPY}" --only-keep-debug "${FFZ_FILE}" "${FFZ_FILE}.debug" RESULT_VARIABLE FFZ_RESULT)
if(NOT FFZ_RESULT EQUAL 0)
  message(FATAL_ERROR "符号处理失败：${FFZ_RESULT}")
endif()
execute_process(COMMAND "${FFZ_STRIP}" --strip-all "${FFZ_FILE}" RESULT_VARIABLE FFZ_RESULT)
if(NOT FFZ_RESULT EQUAL 0)
  message(FATAL_ERROR "符号处理失败：${FFZ_RESULT}")
endif()
execute_process(COMMAND "${FFZ_OBJCOPY}" "--add-gnu-debuglink=${FFZ_FILE}.debug" "${FFZ_FILE}" RESULT_VARIABLE FFZ_RESULT)
if(NOT FFZ_RESULT EQUAL 0)
  message(FATAL_ERROR "符号处理失败：${FFZ_RESULT}")
endif()
