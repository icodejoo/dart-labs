mova/libmpv/** filter=lfs diff=lfs merge=lfs -text
# README 是普通文本，不进 LFS
mova/libmpv/README.md !filter !diff !merge text
# VERSION 是普通文本（版本/sha256 记录），不进 LFS
mova/libmpv/VERSION !filter !diff !merge text
mova/packages/**/*.so filter=lfs diff=lfs merge=lfs -text
mova/packages/**/*.dll filter=lfs diff=lfs merge=lfs -text
mova/packages/**/*.dylib filter=lfs diff=lfs merge=lfs -text
mova/packages/**/*.a filter=lfs diff=lfs merge=lfs -text
mova/packages/**/Mpv filter=lfs diff=lfs merge=lfs -text


mova/example/tool/rerun-sources/codec/*.mp4 filter=lfs diff=lfs merge=lfs -text
mova/example/tool/rerun-sources/codec/*.webm filter=lfs diff=lfs merge=lfs -text

# shell 脚本强制 LF，避免 Windows autocrlf 破坏 shebang
*.sh text eol=lf
