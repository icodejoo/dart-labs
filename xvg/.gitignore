# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# NOTE: `prebuilt/` is intentionally NOT ignored. xvg distributes precompiled
# native binaries committed directly into git (no Git LFS — pub cannot resolve
# LFS pointers through its git checkouts). Ignoring it would silently break
# every consumer.
#
# 注意：`prebuilt/` 刻意不加入 ignore。xvg 直接把预编译原生二进制提交进 git
# （不用 Git LFS——pub 的 git checkout 拉不到 LFS 指针指向的实体文件）。
# 把它 ignore 掉会静默破坏所有下游。

# Recreated by the podspec at pod install; git/pub ship only Versions/A.
# podspec 在 pod install 时补建；git/pub 只分发 Versions/A。
/macos/xvg.framework/Versions/Current
/macos/xvg.framework/xvg
/macos/xvg.framework/Resources

# FVM Version Cache
.fvm/
/example/web/pkg/
