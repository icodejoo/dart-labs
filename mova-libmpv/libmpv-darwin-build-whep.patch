diff --git a/nix/packages/mk-pkg-libplacebo/default.nix b/nix/packages/mk-pkg-libplacebo/default.nix
new file mode 100644
index 0000000..9cb9b1c
--- /dev/null
+++ b/nix/packages/mk-pkg-libplacebo/default.nix
@@ -0,0 +1,102 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+  # 取 flavor 只为让 cross-file 带上 movaslim 的 slim 旗标（-fvisibility=hidden / LTO / dead_strip）
+  flavor ? import ../../utils/default/flavor.nix,
+}:
+
+# mpv 0.41 的硬依赖。与 Android/Windows 同为 v7.360.0 的最小静态构建：
+# 只给 mpv 的 vo_gpu 用（gpu-next 已被 mpv-v041/0001 摘掉），关掉 vulkan/d3d11/着色器编译器/色彩管理等。
+let
+  name = "libplacebo";
+  lock = import ../../../packages.lock.nix;
+  packageLock = lock.${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch flavor; };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+  xctoolchainLipo = callPackage ../../utils/xctoolchain/lipo.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+
+  # GitHub 的 tag 压缩包不含 git 子模块，按 v7.360.0 的 .gitmodules 逐个钉 commit 拼进 3rdparty/
+  fetchSub = key: callPackage ../../utils/fetch-tarball/default.nix {
+    name = "libplacebo-${key}-source-${lock.${key}.version}";
+    inherit (lock.${key}) url sha256;
+  };
+  jinja = fetchSub "libplaceboJinja";
+  markupsafe = fetchSub "libplaceboMarkupsafe";
+  fastFloat = fetchSub "libplaceboFastFloat";
+  glad = fetchSub "libplaceboGlad";
+  vulkanHeaders = fetchSub "libplaceboVulkanHeaders";
+
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    cp -r ${src} $out
+    chmod -R u+w $out
+
+    for pair in jinja:${jinja} markupsafe:${markupsafe} fast_float:${fastFloat} glad:${glad} Vulkan-Headers:${vulkanHeaders}; do
+      dir=''${pair%%:*}
+      from=''${pair#*:}
+      rm -rf $out/3rdparty/$dir
+      cp -r $from $out/3rdparty/$dir
+      chmod -R u+w $out/3rdparty/$dir
+    done
+
+    # 静态库默认仍带 -DPL_EXPORT，会让 ~120 个 pl_* 符号以默认可见性进 libmpv.dylib 的导出表，
+    # 也让 dead_strip 保不住它们；静态构建改用 -DPL_STATIC（与 Windows 构建同一处 sed）。
+    sed -i "s|c_args: \['-DPL_EXPORT'\],|c_args: get_option('default_library') == 'static' ? ['-DPL_STATIC'] : ['-DPL_EXPORT'],|" \
+      $out/src/meson.build
+    grep -q "PL_STATIC'\] : \['-DPL_EXPORT" $out/src/meson.build
+  '';
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+    pkgs.python3
+    # meson 的 find_library 会直接调 PATH 里的 lipo（见 xctoolchain/lipo.nix）
+    xctoolchainLipo
+  ];
+  configurePhase = ''
+    meson setup build $src \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out \
+      --default-library=static \
+      -Dbuildtype=minsize -Ddebug=false -Db_ndebug=true \
+      -Dvulkan=disabled \
+      -Dopengl=disabled \
+      -Dd3d11=disabled \
+      -Dglslang=disabled \
+      -Dshaderc=disabled \
+      -Dlcms=disabled \
+      -Ddovi=disabled \
+      -Dlibdovi=disabled \
+      -Dxxhash=disabled \
+      -Dunwind=disabled \
+      -Ddemos=false \
+      -Dtests=false \
+      -Dbench=false \
+      -Dfuzz=false
+  '';
+  buildPhase = ''
+    meson compile -vC build
+  '';
+  installPhase = ''
+    meson install -C build
+  '';
+}
