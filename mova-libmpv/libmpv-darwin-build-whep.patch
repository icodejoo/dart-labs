+        $out/subprojects/mbedtls/include/mbedtls/mbedtls_config.h
+      grep -q '^#define MBEDTLS_SSL_DTLS_SRTP' \
+        $out/subprojects/mbedtls/include/mbedtls/mbedtls_config.h
+    ''}
   '';
 in
 
@@ -43,7 +59,8 @@ pkgs.stdenvNoCC.mkDerivation {
     meson setup build $src \
       --native-file ${nativeFile} \
       --cross-file ${crossFile} \
-      --prefix=$out
+      --prefix=$out \
+      -Dlinking=${if isSlim then "static" else "shared"}
   '';
   buildPhase = ''
     meson compile -vC build
@@ -59,7 +76,11 @@ pkgs.stdenvNoCC.mkDerivation {
     cp $src/subprojects/mbedtls/include/psa/*.h $out/include/psa/
 
     # install libs
-    find build -type f -name '*.dylib' -exec sh -c 'cp {} $out/lib/' \;
