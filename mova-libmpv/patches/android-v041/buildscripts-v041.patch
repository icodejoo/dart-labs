diff --git a/buildscripts/scripts/libplacebo.sh b/buildscripts/scripts/libplacebo.sh
new file mode 100755
index 0000000..1d0bab5
--- /dev/null
+++ b/buildscripts/scripts/libplacebo.sh
@@ -0,0 +1,27 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	exit 0
+else
+	exit 255
+fi
+
+unset CC CXX # meson wants these unset
+
+# 最小静态 libplacebo：只给 mpv 的 vo_gpu（OpenGL ES）用，砍掉 vulkan/着色器编译器/色彩管理等
+meson setup $build --cross-file "$prefix_dir"/crossfile.txt --native-file "$prefix_dir"/native.txt \
+	--default-library static \
+	-Dvulkan=disabled -Dd3d11=disabled -Dglslang=disabled -Dshaderc=disabled \
+	-Dlcms=disabled -Ddovi=disabled -Dlibdovi=disabled -Dxxhash=disabled -Dunwind=disabled \
+	-Ddemos=false -Dtests=false -Dbench=false -Dfuzz=false
+
+ninja -C $build -j$cores
+DESTDIR="$prefix_dir" ninja -C $build install
