 	-Dgpl=false \
 	-Dlibmpv=true \
- 	-Dlua=disabled \
- 	-Dcplayer=false \
-	-Diconv=disabled \
-	-Dvulkan=disabled \
-   	-Dlibplacebo=disabled \
- 	-Dmanpage-build=disabled
+	-Dcplayer=false \
+	-Dtests=false \
+	-Dbuild-date=false \
+	-Dlua=disabled \
+	-Dmanpage-build=disabled \
+	-Dzlib=enabled \
+	-Dgl=enabled \
+	-Dplain-gl=enabled \
