+/**
+ * 处理收到的一个 STUN 报文：对服务端的检查请求，校验后回成功响应；
+ * 对我方检查（事务 ID 为 tid，可为 NULL）的成功响应，校验事务 ID 与 HMAC。
+ * @return 1 收到经校验的、对 tid 的成功响应；2 应答了服务端的检查请求；0 其他/不通过
+ */
+static int whep_stun_input(WHEPContext *w, const uint8_t *buf, int n, const uint8_t *tid)
+{
+    uint8_t out[WHEP_UDP_BUF_SIZE];
+    char user[300];
+    int type;
+
+    if (n < STUN_HDR_SIZE || (buf[0] & 0xC0) || AV_RB32(buf + 4) != STUN_COOKIE)
+        return 0;
+    type = AV_RB16(buf);
+    if (type == 0x0001) {
+        snprintf(user, sizeof(user), "%s:%s", w->ice_ufrag_local, w->answer.ufrag);
+        if (whep_stun_verify(buf, n, w->ice_pwd_local, user) &&
+            (n = whep_ice_build_response(w, out, buf + 8)) > 0) {
+            ffurl_write(w->udp, out, n);
+            return 2;
+        }
+    } else if (type == 0x0101 && tid && !memcmp(buf + 8, tid, 12) &&
+               whep_stun_verify(buf, n, w->answer.pwd, NULL)) {
+        return 1;
+    }
+    return 0;
+}
