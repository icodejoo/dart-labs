+/**
+ * 周期性事务：缺口等待超时就放弃；到点发 consent 检查（STUN 请求）；
+ * 长时间没有任何经认证的对端数据（RTP/RTCP/STUN）则判定连接已死。
+ * @return 0 正常，AVERROR(ETIMEDOUT) 连接死亡，AVERROR_EOF 所有流都收到 BYE
+ */
+static int whep_rx_housekeeping(AVFormatContext *s, int64_t now)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t out[WHEP_UDP_BUF_SIZE];
+    int n, byes = 0, active = 0;
+
+    for (int i = 0; i < WHEP_MAX_MEDIA; i++) {
+        WhepRx *rx = &w->rx[i];
+        int64_t oldest = INT64_MAX;
+
+        if (!rx->active)
+            continue;
+        active++;
+        byes += rx->bye;
+        for (int k = 0; k < rx->nb_held; k++)
+            oldest = FFMIN(oldest, rx->held[k].t);
+        if (rx->nb_held && now - oldest > WHEP_REORDER_WAIT_US)
+            whep_rx_flush_gap(s, rx);
+    }
+    if (active && byes == active)
+        return AVERROR_EOF;
