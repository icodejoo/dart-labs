+/* ------------------------------------------------------------------ */
+/* 媒体接收：SRTP 解密、RTP 重排与解包（T1.3 阶段 B）                    */
+/* ------------------------------------------------------------------ */
+
+/**
+ * 用阶段 A 导出的材料初始化各路接收用的 SRTP 上下文。
+ * 材料布局 client_key|server_key|client_salt|server_salt（RFC 5764）。我方是 DTLS server，
+ * 对端（client）用 client 写密钥加密发给我们的包，所以接收解密用 client_key + client_salt
+ * （与 whip.c 被动端约定一致；server 密钥只用于我方发送，WHEP 不发 SRTP，故不使用）。
+ * 每路媒体一个独立 SRTPContext：ffmpeg 的 SRTP 只有一份 seq/ROC 状态，多个 SSRC 共用会互相污染。
+ * @return 0 成功，负值失败
+ */
+static int whep_rx_init(AVFormatContext *s)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t key[WHEP_SRTP_KEY_LEN + WHEP_SRTP_SALT_LEN];
+    char b64[AV_BASE64_SIZE(sizeof(key))];
+    int ret = 0;
+
+    memcpy(key, w->srtp_materials, WHEP_SRTP_KEY_LEN);
+    memcpy(key + WHEP_SRTP_KEY_LEN, w->srtp_materials + 2 * WHEP_SRTP_KEY_LEN, WHEP_SRTP_SALT_LEN);
+    if (!av_base64_encode(b64, sizeof(b64), key, sizeof(key))) {
+        ret = AVERROR(EIO);
+        goto end;
+    }
+    for (int i = 0; i < w->answer.nb_media; i++) {
+        const WhepMedia *m = &w->answer.media[i];
+        WhepRx *rx = &w->rx[i];
+
+        if (m->sel < 0)
+            continue;
+        rx->active       = 1;
+        rx->is_video     = m->type == AVMEDIA_TYPE_VIDEO;
+        rx->pt           = m->codec[m->sel].pt;
+        rx->clock        = m->codec[m->sel].clock > 0 ? m->codec[m->sel].clock : (rx->is_video ? 90000 : 48000);
+        rx->stream_index = m->stream_index;
+        if ((ret = ff_srtp_set_crypto(&rx->srtp, "SRTP_AES128_CM_HMAC_SHA1_80", b64)) < 0) {
+            av_log(s, AV_LOG_ERROR, "Cannot set up SRTP receive context\n");
+            goto end;
+        }
+    }
+end:
+    memset(key, 0, sizeof(key));
+    memset(b64, 0, sizeof(b64));
+    return ret;
+}
+
+/**
+ * 释放接收侧的全部缓冲与 SRTP 上下文，并在 verbose 日志里给出各路计数。
+ */
+static void whep_rx_free(AVFormatContext *s)
+{
+    WHEPContext *w = s->priv_data;
+
+    for (int i = 0; i < WHEP_MAX_MEDIA; i++) {
+        WhepRx *rx = &w->rx[i];
+
+        if (rx->active)
+            av_log(s, AV_LOG_VERBOSE,
+                   "RTP %s pt=%d: packets=%"PRIu64" auth_fail=%"PRIu64" late/dup=%"PRIu64" lost=%"PRIu64
+                   " frames=%"PRIu64" dropped_frames=%"PRIu64" before_keyframe=%"PRIu64"\n",
+                   rx->is_video ? "video" : "audio", rx->pt, rx->n_pkts, rx->n_auth_fail,
+                   rx->n_late, rx->n_lost, rx->n_out, rx->n_drop_au, rx->n_nokey);
+        for (int k = 0; k < rx->nb_held; k++)
+            av_freep(&rx->held[k].buf);
+        av_freep(&rx->au);
+        ff_srtp_free(&rx->srtp);
+    }
+    av_log(s, AV_LOG_VERBOSE,
+           "STUN: server checks answered=%"PRIu64" consent responses=%"PRIu64"; RTCP auth_fail=%"PRIu64" unknown_pt=%"PRIu64"\n",
+           w->n_stun_req, w->n_stun_resp, w->n_rtcp_fail, w->n_unknown_pt);
+    ff_packet_list_free(&w->out);
+    memset(w->rx, 0, sizeof(w->rx));
+}
+
 /**
- * 关闭媒体通路：先 DTLS（需要 udp 还在才能发 close_notify），再 UDP；清掉密钥材料。
+ * 把一个完整的编码帧放进输出队列，时间戳单位为该流的 clock（即流 time_base）。
+ */
+static void whep_rx_emit(AVFormatContext *s, WhepRx *rx, const uint8_t *data, int size,
+                         int64_t pts, int key, int64_t duration)
+{
+    WHEPContext *w = s->priv_data;
+    AVPacket *pkt = av_packet_alloc();
+
+    if (!pkt)
+        return;
+    if (av_new_packet(pkt, size) < 0) {
+        av_packet_free(&pkt);
+        return;
+    }
+    memcpy(pkt->data, data, size);
+    pkt->stream_index = rx->stream_index;
+    pkt->pts          = pts;
+    pkt->duration     = duration;
+    pkt->flags        = key ? AV_PKT_FLAG_KEY : 0;
+    if (ff_packet_list_put(&w->out, pkt, NULL, 0) < 0)
+        av_packet_unref(pkt);
+    else
+        rx->n_out++;
+    av_packet_free(&pkt);
+}
+
+/**
+ * 解析 Opus TOC 得到该包的采样数（48kHz），非法返回 0。
+ */
+static int whep_opus_duration(const uint8_t *p, int size)
+{
+    unsigned toc = p[0], cfg = toc >> 3, cnt = toc & 3, frames = 1;
+    unsigned fs  = cfg < 12 ? FFMAX(480, 960 * (cfg & 3)) : cfg < 16 ? 480u << (cfg & 1) : 120u << (cfg & 3);
+
+    if (cnt == 3) {
+        if (size < 2)
+            return 0;
+        frames = p[1] & 0x3f;
+    } else if (cnt) {
+        frames = 2;
+    }
+    return fs * frames;
+}
+
+/**
+ * 往正在拼装的 H.264 访问单元里追加一个 NAL（Annex B，带起始码）或一段 FU 续片（不带起始码）。
+ */
+static void whep_h264_add(WhepRx *rx, const uint8_t *d, int n, int start_code)
+{
+    static const uint8_t sc[4] = { 0, 0, 0, 1 };
+    int add = n + (start_code ? 4 : 0);
+
+    if (rx->au_size + add > WHEP_MAX_AU) {
+        rx->au_bad = 1;
+        return;
+    }
+    if (rx->au_size + add > rx->au_cap) {
+        unsigned cap = FFMAX(rx->au_cap * 2, rx->au_size + add + 4096);
+        uint8_t *nb  = av_realloc(rx->au, cap);
+        if (!nb) {
+            rx->au_bad = 1;
+            return;
+        }
+        rx->au     = nb;
+        rx->au_cap = cap;
+    }
+    if (start_code) {
+        memcpy(rx->au + rx->au_size, sc, 4);
+        rx->au_size += 4;
+    }
+    memcpy(rx->au + rx->au_size, d, n);
+    rx->au_size += n;
+}
+
+/**
+ * 结束当前访问单元：不完整（丢包）的丢弃；第一个 IDR 之前的丢弃（解码器无法起播）；其余输出。
+ */
+static void whep_h264_au_end(AVFormatContext *s, WhepRx *rx)
+{
+    if (!rx->au_open)
+        return;
+    rx->au_open = 0;
+    rx->fu_open = 0;
+    if (rx->au_bad || !rx->au_size) {
+        rx->n_drop_au++;
+    } else if (!rx->seen_key && !rx->au_key) {
+        rx->n_nokey++;
+    } else {
+        rx->seen_key = 1;
+        whep_rx_emit(s, rx, rx->au, rx->au_size, rx->au_pts, rx->au_key, 0);
+    }
+    rx->au_size = 0;
+}
+
+/**
+ * H.264 RTP 解包（RFC 6184）：单 NAL、STAP-A、FU-A；marker 位或时间戳变化结束一帧。
+ * STAP-B/MTAP/FU-B 不支持（WebRTC 不用），遇到即标记该帧不完整。
+ */
+static void whep_h264_input(AVFormatContext *s, WhepRx *rx, const uint8_t *p, int len,
+                            uint32_t ts, int64_t pts, int marker)
+{
+    int type;
+
+    if (len < 1)
+        return;
+    if (rx->au_open && ts != rx->au_ts)
+        whep_h264_au_end(s, rx);
+    if (!rx->au_open) {
+        rx->au_open = 1;
+        rx->au_ts   = ts;
+        rx->au_pts  = pts;
+        rx->au_size = 0;
+        rx->au_key  = 0;
+        rx->au_bad  = 0;
+    }
+    type = p[0] & 0x1f;
+    if (type >= 1 && type <= 23) {
+        whep_h264_add(rx, p, len, 1);
+        rx->au_key |= type == 5;
+    } else if (type == 24) {                        /* STAP-A */
+        int off = 1;
+        while (off + 2 <= len) {
+            int sz = AV_RB16(p + off);
+            off += 2;
+            if (!sz || sz > len - off) {
+                rx->au_bad = 1;
+                break;
+            }
+            whep_h264_add(rx, p + off, sz, 1);
+            rx->au_key |= (p[off] & 0x1f) == 5;
+            off += sz;
+        }
+    } else if (type == 28 && len >= 2) {            /* FU-A */
+        int fu = p[1];
+        if (fu & 0x80) {                            /* 起始片：重建 NAL 头 */
+            uint8_t hdr = (p[0] & 0xe0) | (fu & 0x1f);
+            whep_h264_add(rx, &hdr, 1, 1);
+            whep_h264_add(rx, p + 2, len - 2, 0);
+            rx->fu_open = 1;
+            rx->au_key |= (fu & 0x1f) == 5;
+        } else if (rx->fu_open) {
+            whep_h264_add(rx, p + 2, len - 2, 0);
+        } else {
+            rx->au_bad = 1;                         /* 起始片丢了 */
+        }
+        if (fu & 0x40)
+            rx->fu_open = 0;
+    } else {
+        rx->au_bad = 1;
+    }
+    if (marker)
+        whep_h264_au_end(s, rx);
+}
+
+/**
+ * 交付一个按序的、已解密的 RTP 包：剥头、换算时间戳、按编码分发解包。
+ * @param now 该包的到达时刻（相对时钟 us），用来把各路流对齐到同一条时间线
+ */
+static void whep_rx_deliver(AVFormatContext *s, WhepRx *rx, const uint8_t *p, int len, int64_t now)
+{
+    WHEPContext *w = s->priv_data;
+    int hdr = WHEP_RTP_MIN + 4 * (p[0] & 0x0f), end = len;
+    uint32_t ts = AV_RB32(p + 4);
+
+    if (p[0] & 0x10) {                               /* 扩展头 */
+        if (hdr + 4 > len)
+            return;
+        hdr += 4 + 4 * AV_RB16(p + hdr + 2);
+    }
+    if (p[0] & 0x20)                                 /* 填充 */
+        end -= p[len - 1];
+    if (hdr >= end || end > len)
+        return;
+    /* 各流的 RTP 时间戳起点随机：以首包为 0，再叠加"该流首包相对全局首包的到达时间差"以对齐 */
+    if (!rx->have_ts) {
+        rx->have_ts   = 1;
+        rx->unwrapped = 0;
+        rx->offset    = av_rescale(now - w->t0_rx, rx->clock, 1000000);
+    } else {
+        rx->unwrapped += (int32_t)(ts - rx->last_ts);
+    }
+    rx->last_ts = ts;
+    if (rx->is_video) {
+        whep_h264_input(s, rx, p + hdr, end - hdr, ts, rx->unwrapped + rx->offset, p[1] >> 7);
+    } else {
+        int dur = whep_opus_duration(p + hdr, end - hdr);
+        whep_rx_emit(s, rx, p + hdr, end - hdr, rx->unwrapped + rx->offset, 0, dur);
+    }
+}
