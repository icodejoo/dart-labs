+/**
+ * 从乱序缓存里连续交付 next_seq 开始的包，直到出现缺口。
+ */
+static void whep_rx_drain(AVFormatContext *s, WhepRx *rx)
+{
+    for (int i = 0; i < rx->nb_held;) {
+        WhepHeld *h = &rx->held[i];
+        if (h->seq != rx->next_seq) {
+            i++;
+            continue;
+        }
+        whep_rx_deliver(s, rx, h->buf, h->len, h->t);
+        rx->next_seq++;
+        av_freep(&h->buf);
+        *h = rx->held[--rx->nb_held];
+        i = 0;
+    }
+}
+
+/**
+ * 放弃等待缺失的包：跳到缓存里最小序号处，记丢包，正在拼装的访问单元视为不完整（FU-A 续片
+ * 缺起始片的情况在解包处另行标记）。
+ */
+static void whep_rx_flush_gap(AVFormatContext *s, WhepRx *rx)
+{
+    int best = 0;
+
+    for (int i = 1; i < rx->nb_held; i++)
+        if ((int16_t)(rx->held[i].seq - rx->held[best].seq) < 0)
+            best = i;
+    rx->n_lost += (uint16_t)(rx->held[best].seq - rx->next_seq);
+    rx->next_seq = rx->held[best].seq;
+    rx->au_bad  |= rx->au_open;
+    rx->fu_open = 0;
+    whep_rx_drain(s, rx);
+}
+
+/**
+ * 收到一个已通过认证并解密的 RTP 包：按序号做重排（缓存上限 WHEP_REORDER_MAX）；
+ * 过旧/重复的丢弃并计数（这也是重放保护：SRTP 层没有重放窗口）。
+ */
+static void whep_rx_push(AVFormatContext *s, WhepRx *rx, const uint8_t *p, int len, int64_t now)
+{
+    uint16_t seq = AV_RB16(p + 2);
+    int d;
+
+    if (!rx->started) {
+        rx->started  = 1;
+        rx->next_seq = seq;
+    }
+    d = (int16_t)(seq - rx->next_seq);
+    if (d < 0) {
+        rx->n_late++;
+        return;
+    }
+    if (d >= WHEP_REORDER_MAX) {                     /* 跳变太大：不等了，先清空缓存再重新对齐 */
+        while (rx->nb_held)
+            whep_rx_flush_gap(s, rx);
+        d = (int16_t)(seq - rx->next_seq);
+        if (d < 0) {
+            rx->n_late++;
+            return;
+        }
+        if (d > 0) {
+            rx->n_lost += d;
+            rx->next_seq = seq;
+            rx->au_bad  |= rx->au_open;
+            rx->fu_open = 0;
+            d = 0;
+        }
+    }
+    if (d == 0) {
+        whep_rx_deliver(s, rx, p, len, now);
+        rx->next_seq++;
+        whep_rx_drain(s, rx);
+        return;
+    }
+    for (int i = 0; i < rx->nb_held; i++)
+        if (rx->held[i].seq == seq) {
+            rx->n_late++;
+            return;
+        }
+    if (rx->nb_held >= WHEP_REORDER_MAX) {           /* 满了：放弃最老的缺口腾位置，再重试 */
+        whep_rx_flush_gap(s, rx);
+        whep_rx_push(s, rx, p, len, now);
+        return;
+    }
+    if (!(rx->held[rx->nb_held].buf = av_memdup(p, len)))
+        return;
+    rx->held[rx->nb_held].len = len;
+    rx->held[rx->nb_held].seq = seq;
+    rx->held[rx->nb_held].t   = now;
+    rx->nb_held++;
+}
