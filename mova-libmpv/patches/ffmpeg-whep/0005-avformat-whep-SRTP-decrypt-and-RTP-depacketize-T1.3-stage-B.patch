+/**
+ * 处理已认证的 RTCP 复合包：只关心 BYE（对端结束该路）；SR 等暂不使用。
+ */
+static void whep_rtcp_input(AVFormatContext *s, const uint8_t *b, int len)
+{
+    WHEPContext *w = s->priv_data;
+
+    for (int off = 0; off + 4 <= len;) {
+        int l = 4 * (AV_RB16(b + off + 2) + 1);
+        if (off + l > len)
+            break;
+        if (b[off + 1] == 203) {                     /* BYE */
+            for (int k = 0, sc = b[off] & 0x1f; k < sc && 4 + 4 * k + 4 <= l; k++) {
+                uint32_t ssrc = AV_RB32(b + off + 4 + 4 * k);
+                for (int i = 0; i < WHEP_MAX_MEDIA; i++)
+                    if (w->rx[i].active && w->rx[i].have_ssrc && w->rx[i].ssrc == ssrc)
+                        w->rx[i].bye = 1;
+            }
+        }
+        off += l;
+    }
+}
