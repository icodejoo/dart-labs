+/**
+ * 处理 UDP 上收到的一个数据报（RFC 7983/5761 分流）：
+ * 0..3 STUN（应答服务端 consent 检查/校验我方检查的响应）、20..63 DTLS（忽略）、
+ * 128..191 RTP 或 RTCP（第二字节 192..223 为 RTCP）。认证失败的包丢弃并计数。
+ */
+static void whep_rx_datagram(AVFormatContext *s, int n, int64_t now)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t *b = w->rxbuf;
+    WhepRx *rx = NULL;
+    int len = n;
+
+    if (b[0] < 4) {
+        int r = whep_stun_input(w, b, n, w->consent_tid);
+        if (r) {
+            w->last_alive = now;
+            if (r == 1)
+                w->n_stun_resp++;
+            else
+                w->n_stun_req++;
+        }
+        return;
+    }
+    if (b[0] >= 20 && b[0] <= 63) {
+        av_log(s, AV_LOG_DEBUG, "Ignoring DTLS record after handshake (content type %d)\n", b[0]);
+        return;
+    }
+    if (b[0] < 128 || b[0] > 191 || n < WHEP_RTP_MIN || (b[0] >> 6) != 2)
+        return;
+    if (b[1] >= 192 && b[1] <= 223) {
+        for (int i = 0; i < WHEP_MAX_MEDIA && !rx; i++)
+            if (w->rx[i].active)
+                rx = &w->rx[i];                      /* RTCP 解密无状态，任一路的上下文都行 */
+        if (rx && ff_srtp_decrypt(&rx->srtp, b, &len) >= 0) {
+            w->last_alive = now;
+            whep_rtcp_input(s, b, len);
+        } else {
+            w->n_rtcp_fail++;
+        }
+        return;
+    }
+    for (int i = 0; i < WHEP_MAX_MEDIA; i++)
+        if (w->rx[i].active && w->rx[i].pt == (b[1] & 0x7f))
+            rx = &w->rx[i];
+    if (!rx) {
+        w->n_unknown_pt++;                           /* RTX 等未协商的 payload type */
+        return;
+    }
+    if (ff_srtp_decrypt(&rx->srtp, b, &len) < 0) {
+        rx->n_auth_fail++;
+        if (!(rx->n_auth_fail & (rx->n_auth_fail - 1)))
+            av_log(s, AV_LOG_WARNING, "SRTP authentication failed, dropped %"PRIu64" packet(s) so far\n",
+                   rx->n_auth_fail);
+        return;
+    }
+    if (len < WHEP_RTP_MIN)
+        return;
+    if (!rx->have_ssrc) {
+        rx->have_ssrc = 1;
+        rx->ssrc      = AV_RB32(b + 8);
+    } else if (AV_RB32(b + 8) != rx->ssrc) {
+        rx->n_late++;                                /* 非首个 SSRC 的包不处理 */
+        return;
+    }
+    w->last_alive = now;
+    if (!w->have_t0) {
+        w->have_t0 = 1;
+        w->t0_rx   = now;
+    }
+    rx->n_pkts++;
+    whep_rx_push(s, rx, b, len, now);
+}
