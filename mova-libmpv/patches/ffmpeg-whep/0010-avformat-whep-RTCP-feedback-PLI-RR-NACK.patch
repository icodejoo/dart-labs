@@ -1524,18 +1602,312 @@ static void whep_rx_drain(AVFormatContext *s, WhepRx *rx)
     }
 }
 
+/* ------------------------------------------------------------------ */
+/* RTCP 反馈（T1.5）：缺口表、NACK / PLI / RR                           */
+/* ------------------------------------------------------------------ */
+
+/**
+ * 不可恢复的丢包发生：视频路请求关键帧（PLI，限速在发送处）。
+ */
+static void whep_loss_note(WhepRx *rx)
+{
+    if (rx->pli_on)
+        rx->pli_pending = 1;
+}
+
+/**
+ * 在缺口表里找序号。
+ * @return 下标，没有则 -1
+ */
+static int whep_gap_find(const WhepRx *rx, uint16_t seq)
+{
+    for (int i = 0; i < rx->nb_gap; i++)
+        if (rx->gap[i].seq == seq)
+            return i;
+    return -1;
+}
+
+/**
+ * 删掉缺口表的一项（与末项交换）。
+ */
+static void whep_gap_del(WhepRx *rx, int i)
+{
+    rx->gap[i] = rx->gap[--rx->nb_gap];
+}
+
+/**
+ * 登记一个缺失序号；表满时先挤掉最老的已放弃项，仍满则放弃 NACK 改走 PLI。
+ */
+static void whep_gap_add(WhepRx *rx, uint16_t seq, int64_t now)
+{
+    if (rx->nb_gap >= WHEP_GAP_MAX) {
+        int old = -1;
+        for (int i = 0; i < rx->nb_gap; i++)
+            if (rx->gap[i].given_up && (old < 0 || rx->gap[i].t_last < rx->gap[old].t_last))
+                old = i;
+        if (old < 0) {
+            whep_loss_note(rx);
+            return;
+        }
+        whep_gap_del(rx, old);
+    }
+    rx->gap[rx->nb_gap++] = (WhepGap){ .seq = seq, .t_first = now };
+}
+
+/**
+ * 一个落在接收窗口内（未过期）的包到达：新高序号则把中间空出的序号登记为缺口，
+ * 乱序/重传补上的序号则从缺口表里划掉；已被 NACK 过的算作"重传恢复"。
+ */
+static void whep_nack_track(WhepRx *rx, uint16_t seq, int64_t now)
+{
+    int d, i;
+
+    if (!rx->hi_valid) {
+        rx->hi_valid = 1;
+        rx->hi       = seq;
+        return;
+    }
+    d = (int16_t)(seq - rx->hi);
+    if (d > 0) {
+        if (d - 1 > WHEP_GAP_MAX) {                  /* 突发丢包超过表容量：不 NACK，等重排窗口放弃后走 PLI */
+            rx->nb_gap = 0;
+            whep_loss_note(rx);
+        } else {
+            for (i = 1; i < d; i++)
+                whep_gap_add(rx, rx->hi + i, now);
+        }
+        rx->hi = seq;
+    } else if ((i = whep_gap_find(rx, seq)) >= 0) {
+        if (rx->gap[i].tries)
+            rx->n_rtx_recv++;
+        whep_gap_del(rx, i);
+    }
+}
+
+/**
+ * 序号落在已过期位置（d<0）时调用：若是此前放弃的缺口，说明是迟到的重传，单独计数，不算 late/dup。
+ * @return 1 已按迟到重传处理，0 不是
+ */
+static int whep_gap_late(WhepRx *rx, uint16_t seq)
+{
+    int i = whep_gap_find(rx, seq);
+
+    if (i < 0 || !rx->gap[i].given_up)
+        return 0;
+    rx->n_rtx_late++;
+    whep_gap_del(rx, i);
+    return 1;
+}
+
+/**
+ * 把升序（模 2^16）的丢失序号打包成 RFC 4585 §6.2.1 的 FCI：PID + BLP，
+ * 与 PID 相差 1..16 的序号并入同一个 FCI，超出另开。
+ * @param seq 丢失序号，已升序，n <= WHEP_GAP_MAX
+ * @param out 输出缓冲，至少 4*n 字节
+ * @return 生成的 FCI 个数
+ */
+static int whep_nack_pack(const uint16_t *seq, int n, uint8_t *out)
+{
+    int fci = 0;
+
+    for (int i = 0; i < n;) {
+        uint16_t pid = seq[i], blp = 0;
+        int j = i + 1;
+
+        for (; j < n && (uint16_t)(seq[j] - pid) >= 1 && (uint16_t)(seq[j] - pid) <= 16; j++)
+            blp |= 1 << ((uint16_t)(seq[j] - pid) - 1);
+        AV_WB16(out + 4 * fci, pid);
+        AV_WB16(out + 4 * fci + 2, blp);
+        fci++;
+        i = j;
+    }
+    return fci;
+}
+
+/**
+ * 按 RFC 3550 §6.4.1 写一个 report block（24 字节）。LSR/DLSR 来自最近一个 SR，没收到过则为 0。
+ * @return 写入后的指针
+ */
+static uint8_t *whep_rr_block(WhepRx *rx, uint8_t *p, int64_t now)
+{
+    uint32_t ext_max  = rx->cycles + rx->max_seq;
+    uint32_t expected = ext_max - rx->base_seq + 1;
+    uint32_t recv     = (uint32_t)rx->n_pkts;
+    int32_t  cum      = (int32_t)(expected - recv);
+    uint32_t exp_int  = expected - rx->prior_exp;
+    int32_t  lost_int = (int32_t)(exp_int - (recv - rx->prior_rec));
+    unsigned frac     = exp_int && lost_int > 0 ? FFMIN(((uint32_t)lost_int << 8) / exp_int, 255) : 0;
+
+    rx->prior_exp = expected;
+    rx->prior_rec = recv;
+    cum = av_clip(cum, -0x800000, 0x7fffff);
+    AV_WB32(p, rx->ssrc);
+    p[4] = frac;
+    AV_WB24(p + 5, cum & 0xffffff);
+    AV_WB32(p + 8, ext_max);
+    AV_WB32(p + 12, rx->jitter >> 4);
+    AV_WB32(p + 16, rx->lsr);
+    AV_WB32(p + 20, rx->lsr ? (uint32_t)av_rescale(now - rx->t_sr, 65536, 1000000) : 0);
+    return p + 24;
+}
+
+/**
+ * 把一个明文复合 RTCP 经 SRTCP 加密（带 E 位与 SRTCP 索引）后从媒体 UDP 发出。发送失败不处理，
+ * 对端失联由存活检测兜底。
+ */
+static void whep_rtcp_send(AVFormatContext *s, const uint8_t *plain, int len)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t out[WHEP_RTCP_BUF + 16];
+    int n;
+
+    if (!w->tx_ready)
+        return;
+    if ((n = ff_srtp_encrypt(&w->tx, plain, len, out, sizeof(out))) > 0)
+        ffurl_write(w->udp, out, n);
+}
+
+/**
+ * 周期事务之一：按需组一个复合 RTCP 发出。结构 = RR（到点带 report block，否则空 RR）
+ * + 每路的 NACK（缺口表里到期的序号）+ 每路的 PLI（限速 WHEP_PLI_MIN_US）。
+ * 缺口表的重试/放弃/过期清理也在这里推进。
+ */
+static void whep_rtcp_feedback(AVFormatContext *s, int64_t now)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t buf[WHEP_RTCP_BUF], *p = buf + 8;
+    int rr_due = w->rtcp_interval > 0 && now >= w->next_rr, nb_rr = 0, fb = 0;
+    uint8_t *fbp = buf + 8;
+
+    /* 先写 report block（RR 必须排在复合包最前），反馈包随后追加 */
+    for (int i = 0; i < WHEP_MAX_MEDIA && rr_due; i++)
+        if (w->rx[i].active && w->rx[i].got_seq && w->rx[i].have_ssrc) {
+            p = whep_rr_block(&w->rx[i], p, now);
+            w->rx[i].n_rr++;
+            nb_rr++;
+        }
+    fbp = p;
+    for (int i = 0; i < WHEP_MAX_MEDIA; i++) {
+        WhepRx *rx = &w->rx[i];
+        uint16_t miss[WHEP_GAP_MAX];
+        int n = 0;
+
+        if (!rx->active || !rx->have_ssrc)
+            continue;
+        for (int k = 0; k < rx->nb_gap && rx->nack_on;) {
+            WhepGap *g = &rx->gap[k];
+
+            if (g->given_up) {
+                if (now - g->t_last > WHEP_GAP_KEEP_US) {
+                    whep_gap_del(rx, k);
+                    continue;
+                }
+            } else if (g->tries ? now - g->t_last >= WHEP_NACK_RETRY_US
+                                : now - g->t_first >= WHEP_NACK_DELAY_US) {
+                if (g->tries >= WHEP_NACK_TRIES) {   /* 重试用尽：放弃，视频降级 PLI */
+                    g->given_up = 1;
+                    g->t_last   = now;
+                    rx->n_nack_giveup++;
+                    whep_loss_note(rx);
+                } else {
+                    miss[n++] = g->seq;
+                    g->tries++;
+                    g->t_last = now;
+                }
+            }
+            k++;
+        }
+        if (n) {
+            int fci;
+            for (int a = 1; a < n; a++) {            /* 插入排序，按模 2^16 升序 */
+                uint16_t v = miss[a];
+                int b = a - 1;
+                for (; b >= 0 && (int16_t)(miss[b] - v) > 0; b--)
+                    miss[b + 1] = miss[b];
+                miss[b + 1] = v;
+            }
+            fci = whep_nack_pack(miss, n, fbp + 12);
+            AV_WB16(fbp, 0x8100 | 205);              /* V=2 FMT=1 PT=205 */
+            AV_WB16(fbp + 2, 2 + fci);
+            AV_WB32(fbp + 4, w->local_ssrc);
+            AV_WB32(fbp + 8, rx->ssrc);
+            fbp += 12 + 4 * fci;
+            rx->n_nack_seq += n;
+            rx->n_nack_msg++;
+            fb = 1;
+        }
+        if (rx->pli_on && !rx->seen_key)             /* 起播：尽快要关键帧，之后按 1 次/秒重试 */
+            rx->pli_pending = 1;
+        if (rx->pli_pending && (!rx->last_pli || now - rx->last_pli >= WHEP_PLI_MIN_US)) {
+            AV_WB16(fbp, 0x8100 | 206);              /* V=2 FMT=1 PT=206 */
+            AV_WB16(fbp + 2, 2);
+            AV_WB32(fbp + 4, w->local_ssrc);
+            AV_WB32(fbp + 8, rx->ssrc);
+            fbp += 12;
+            rx->pli_pending = 0;
+            rx->last_pli    = now;
+            rx->n_pli++;
+            fb = 1;
+        }
+    }
+    if (!nb_rr && !fb)
+        return;
