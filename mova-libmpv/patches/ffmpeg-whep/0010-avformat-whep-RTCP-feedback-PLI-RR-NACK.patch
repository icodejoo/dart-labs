From 8c212dba61dde465f9a2df80d5203b63b81ea036 Mon Sep 17 00:00:00 2001
From: jelon <jelon@tbu.net>
Date: Fri, 2 Oct 2026 18:53:17 +0800
Subject: [PATCH 10/10] avformat/whep: RTCP feedback (PLI, RR, NACK) over SRTCP,
 T1.5

Send RTCP from the media UDP socket, encrypted as SRTCP with the DTLS server write key
(the existing rx contexts use the client key): a periodic Receiver Report (report block
with fraction/cumulative lost, extended highest sequence, RFC 3550 A.8 jitter, LSR/DLSR
from the last SR), NACK (RFC 4585 6.2.1, PID+BLP multi-FCI packing) and PLI (6.3.1).
Local SSRC is random (a recvonly offer needs no declaration).

NACK: a 32-entry gap table (seq, tries, first seen, last NACK) fed by the reorder
queue; first NACK after 10ms, retry every 40ms, 3 tries, then give up and fall back to
PLI; late retransmits for given-up gaps are counted separately, not as late/dup. With
nack on the reorder wait grows from 80ms to 200ms. Only the no-RTX path is implemented:
a media section whose answer negotiated RTX does not send NACK (TODO). PLI is rate
limited to 1/s, sent at the first video packet until a key frame is seen and after any
unrecoverable video loss. All feedback is sent only when the answer declared nack /
nack pli. New options: rtcp_nack, rtcp_pli, rtcp_interval. Verbose counters and first
packet / first key frame timings added.
---
 libavformat/whep.c | 400 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 396 insertions(+), 4 deletions(-)
 mode change 100755 => 100644 libavformat/whep.c

diff --git a/libavformat/whep.c b/libavformat/whep.c
old mode 100755
new mode 100644
index 46f9b4d..54b1591
--- a/libavformat/whep.c
+++ b/libavformat/whep.c
@@ -86,6 +86,17 @@
 /* 每路乱序缓存的最大包数；缺口最多等待的时间（微秒） */
 #define WHEP_REORDER_MAX      32
 #define WHEP_REORDER_WAIT_US  80000
+/* RTCP 反馈（T1.5）：NACK 缺口表容量、首次 NACK 前的乱序容忍、重发间隔、最大重试次数、
+ * 开 NACK 时缺口的最长等待、已放弃缺口的保留期、PLI 最小间隔（均为自拟起点，须按网络校准） */
+#define WHEP_GAP_MAX          32
+#define WHEP_NACK_DELAY_US    10000
+#define WHEP_NACK_RETRY_US    40000
+#define WHEP_NACK_TRIES       3
+#define WHEP_NACK_WAIT_US     200000
+#define WHEP_GAP_KEEP_US      1000000
+#define WHEP_PLI_MIN_US       1000000
+/* 复合 RTCP 明文缓冲上限：RR(8+WHEP_MAX_MEDIA*24)+每路(NACK 12+4*32 + PLI 12)，最坏 8+4*24+4*152=712 字节 */
+#define WHEP_RTCP_BUF         768
 /* 单个视频访问单元的大小上限，防异常流撑爆内存 */
 #define WHEP_MAX_AU           (8 << 20)
 /* read_packet 阻塞等待时每轮的 poll 时长（毫秒）：每轮都检查中断、做周期事务 */
@@ -161,6 +172,15 @@ typedef struct WhepHeld {
     int64_t  t;             /* 到达时刻（us） */
 } WhepHeld;
 
+/* NACK 缺口表的一项：一个尚未收到的序号 */
+typedef struct WhepGap {
+    uint16_t seq;
+    uint8_t  tries;         /* 已发 NACK 次数 */
+    uint8_t  given_up;      /* 1：已放弃重传（保留一段时间只为识别迟到的重传包） */
+    int64_t  t_first;       /* 首次发现缺口的时刻（us） */
+    int64_t  t_last;        /* 上次发 NACK（或放弃）的时刻（us） */
+} WhepGap;
+
