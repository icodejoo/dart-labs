+    int64_t next_rr;                 /* 下次发 RR 的时刻 */
+    int64_t t_first_pkt;             /* 首个媒体包到达时刻（verbose 起播计时用） */
     WhepSdp answer;
     WhepIceServer ice_servers[WHEP_MAX_ICE_SERVER];
     int     nb_ice_servers;
@@ -1275,11 +1321,30 @@ static int whep_rx_init(AVFormatContext *s)
         rx->pt           = m->codec[m->sel].pt;
         rx->clock        = m->codec[m->sel].clock > 0 ? m->codec[m->sel].clock : (rx->is_video ? 90000 : 48000);
         rx->stream_index = m->stream_index;
+        /* 只在 answer 声明了反馈能力时才发；协商了 RTX 时重传走 RTX 包，我们尚不会还原，故不发 NACK（TODO） */
+        rx->nack_on = w->rtcp_nack && m->codec[m->sel].nack && m->rtx_pt < 0;
+        rx->pli_on  = w->rtcp_pli && m->codec[m->sel].pli && rx->is_video;
