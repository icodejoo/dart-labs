+    /* RTCP 反馈（T1.5） */
+    int         nack_on, pli_on;    /* 该路协商了 nack / nack pli 且选项开启 */
+    int         hi_valid;
+    uint16_t    hi;                 /* 已见到的最高序号（缺口检测用） */
+    WhepGap     gap[WHEP_GAP_MAX];
+    int         nb_gap;
+    int         pli_pending;
+    int64_t     last_pli;           /* 上次发 PLI 的时刻，0 表示从未发 */
+    int         got_seq;            /* 统计用序号状态是否已初始化 */
+    uint16_t    max_seq;
+    uint32_t    cycles, base_seq;   /* 序号回绕次数（<<16）、首个序号 */
+    uint32_t    prior_exp, prior_rec; /* 上一份 RR 时的期望/实收包数，用来算 fraction lost */
+    int         have_transit;
+    int64_t     transit;
+    uint32_t    jitter;             /* RFC 3550 A.8，单位 clock 的 1/16 */
+    uint32_t    lsr;                /* 最近 SR 的 NTP 中间 32 位，无则 0 */
+    int64_t     t_sr;               /* 该 SR 的到达时刻（us） */
     /* 计数 */
