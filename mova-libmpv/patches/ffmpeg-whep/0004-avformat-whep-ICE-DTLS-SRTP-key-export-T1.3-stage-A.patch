-static int whep_media_open(AVFormatContext *s)
+static int whep_stun_seal(uint8_t *b, int n, const char *pwd)
+{
+    AVHMAC *h = av_hmac_alloc(AV_HMAC_SHA1);
+
+    if (!h)
+        return AVERROR(ENOMEM);
+    AV_WB16(b + n,     STUN_ATTR_INTEGRITY);
+    AV_WB16(b + n + 2, 20);
+    AV_WB16(b + 2, n + 24 - STUN_HDR_SIZE);   /* 长度含 MI、不含 FINGERPRINT */
+    av_hmac_init(h, (const uint8_t *)pwd, strlen(pwd));
+    av_hmac_update(h, b, n);
+    av_hmac_final(h, b + n + 4, 20);
+    av_hmac_free(h);
+    n += 24;
+    AV_WB16(b + n,     STUN_ATTR_FINGERPRINT);
+    AV_WB16(b + n + 2, 4);
+    AV_WB16(b + 2, n + 8 - STUN_HDR_SIZE);
+    AV_WB32(b + n + 4, (av_crc(av_crc_get_table(AV_CRC_32_IEEE_LE), 0xFFFFFFFF, b, n) ^ 0xFFFFFFFF) ^ 0x5354554E);
+    return n + 8;
+}
+
+/**
+ * 写 STUN 报文头（类型 + cookie + 事务 ID），返回头长度 20。
+ */
+static int whep_stun_header(uint8_t *b, int type, const uint8_t *tid)
+{
+    AV_WB16(b, type);
+    AV_WB16(b + 2, 0);
+    AV_WB32(b + 4, STUN_COOKIE);
+    memcpy(b + 8, tid, 12);
+    return STUN_HDR_SIZE;
+}
+
+/**
+ * 构造 ICE 连通性检查请求（controlling，带 USE-CANDIDATE 即激进提名）。
+ * USERNAME = 对端ufrag:本端ufrag，MESSAGE-INTEGRITY 用对端 pwd。
+ * @return 报文长度，负值失败
+ */
+static int whep_ice_build_request(WHEPContext *w, uint8_t *b, const uint8_t *tid)
+{
+    char user[300];
+    int ulen = snprintf(user, sizeof(user), "%s:%s", w->answer.ufrag, w->ice_ufrag_local);
+    int pad = (4 - ulen % 4) % 4, n;
+
+    if (ulen <= 0 || ulen >= (int)sizeof(user))
+        return AVERROR(EINVAL);
+    n = whep_stun_header(b, 0x0001, tid);
+    AV_WB16(b + n, STUN_ATTR_USERNAME);
+    AV_WB16(b + n + 2, ulen);
+    memcpy(b + n + 4, user, ulen);
+    memset(b + n + 4 + ulen, 0, pad);
+    n += 4 + ulen + pad;
+    AV_WB16(b + n, STUN_ATTR_PRIORITY);       AV_WB16(b + n + 2, 4);
+    AV_WB32(b + n + 4, STUN_HOST_PRIORITY);   n += 8;
+    AV_WB16(b + n, STUN_ATTR_CONTROLLING);    AV_WB16(b + n + 2, 8);
+    AV_WB64(b + n + 4, w->ice_tie_breaker);   n += 12;
+    AV_WB16(b + n, STUN_ATTR_USE_CANDIDATE);  AV_WB16(b + n + 2, 0);
+    n += 4;
+    return whep_stun_seal(b, n, w->answer.pwd);
+}
+
+/**
+ * 构造对服务端检查请求的成功响应：XOR-MAPPED-ADDRESS（对端地址，取自已 connect 的 socket）
+ * + MESSAGE-INTEGRITY(本端 pwd) + FINGERPRINT。
+ * @return 报文长度，负值失败
+ */
+static int whep_ice_build_response(WHEPContext *w, uint8_t *b, const uint8_t *tid)
+{
+    struct sockaddr_storage ss;
+    socklen_t sl = sizeof(ss);
+    uint8_t mask[16];
+    int n = whep_stun_header(b, 0x0101, tid), alen, i;
+
+    if (getpeername(ffurl_get_file_handle(w->udp), (struct sockaddr *)&ss, &sl) < 0)
+        return AVERROR(EIO);
+    AV_WB32(mask, STUN_COOKIE);
+    memcpy(mask + 4, tid, 12);
+    AV_WB16(b + n, STUN_ATTR_XOR_MAPPED);
+    b[n + 4] = 0;
+    if (ss.ss_family == AF_INET) {
+        const struct sockaddr_in *a = (const struct sockaddr_in *)&ss;
+        alen = 4;
+        b[n + 5] = 1;
+        AV_WB16(b + n + 6, ntohs(a->sin_port) ^ (STUN_COOKIE >> 16));
+        memcpy(b + n + 8, &a->sin_addr, 4);
+#if HAVE_STRUCT_SOCKADDR_IN6
+    } else if (ss.ss_family == AF_INET6) {
+        const struct sockaddr_in6 *a = (const struct sockaddr_in6 *)&ss;
+        alen = 16;
+        b[n + 5] = 2;
+        AV_WB16(b + n + 6, ntohs(a->sin6_port) ^ (STUN_COOKIE >> 16));
+        memcpy(b + n + 8, &a->sin6_addr, 16);
+#endif
+    } else {
+        return AVERROR(EAFNOSUPPORT);
+    }
+    for (i = 0; i < alen; i++)
+        b[n + 8 + i] ^= mask[i];
+    AV_WB16(b + n + 2, 4 + alen);
+    n += 8 + alen;
+    return whep_stun_seal(b, n, w->ice_pwd_local);
+}
+
+/**
+ * 校验收到的 STUN 报文：长度自洽、有 MESSAGE-INTEGRITY 且 HMAC(pwd) 匹配；
+ * user 非空时还要求 USERNAME 完全一致（用于服务端发来的检查请求）。
+ * @return 1 通过，0 不通过
+ */
+static int whep_stun_verify(const uint8_t *b, int size, const char *pwd, const char *user)
+{
+    int len = size >= STUN_HDR_SIZE ? AV_RB16(b + 2) : -1, o = STUN_HDR_SIZE;
+    int mi = -1, user_ok = !user;
+    uint8_t lenb[2], mac[20];
+    AVHMAC *h;
+
+    if (len < 0 || len + STUN_HDR_SIZE > size || (len & 3))
+        return 0;
+    while (o + 4 <= STUN_HDR_SIZE + len) {
+        int type = AV_RB16(b + o), alen = AV_RB16(b + o + 2);
+        if (o + 4 + alen > STUN_HDR_SIZE + len)
+            return 0;
+        if (type == STUN_ATTR_INTEGRITY && alen == 20) {
+            mi = o;
+            break;
+        }
+        if (user && type == STUN_ATTR_USERNAME)
+            user_ok = alen == (int)strlen(user) && !memcmp(b + o + 4, user, alen);
+        o += 4 + ((alen + 3) & ~3);
+    }
+    if (mi < 0 || !user_ok || !(h = av_hmac_alloc(AV_HMAC_SHA1)))
+        return 0;
+    AV_WB16(lenb, mi + 24 - STUN_HDR_SIZE);
+    av_hmac_init(h, (const uint8_t *)pwd, strlen(pwd));
+    av_hmac_update(h, b, 2);
+    av_hmac_update(h, lenb, 2);
+    av_hmac_update(h, b + 4, mi - 4);
+    av_hmac_final(h, mac, 20);
+    av_hmac_free(h);
+    return !memcmp(mac, b + mi + 4, 20);
+}
+
