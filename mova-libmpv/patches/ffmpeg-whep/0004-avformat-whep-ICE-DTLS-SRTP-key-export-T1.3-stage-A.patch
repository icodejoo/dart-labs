+/**
+ * DTLS 握手（我方是 server，answer 为 setup:active）：握手后必须取到对端证书，
+ * 其 SHA-256 指纹与 answer 声明的一致才放行；随后导出 SRTP 密钥材料。
+ * 只有 OpenSSL 后端提供对端指纹，其余后端一律拒绝（失败即关闭，不放行未验证的对端）。
+ * @return 0 成功，负值失败
+ */
+static int whep_dtls_handshake(AVFormatContext *s)
+{
+    WHEPContext *w = s->priv_data;
+    AVIOInterruptCB cb = { whep_handshake_interrupt, s };
+    AVDictionary *opts = NULL;
+    char url[256], *peer_fp = NULL;
+    int ret;
+
+    if (strcmp(w->answer.setup, "active")) {
+        av_log(s, AV_LOG_ERROR, "Unsupported answer setup:%s (only setup:active is implemented)\n",
+               w->answer.setup);
+        return AVERROR_PATCHWELCOME;
+    }
+    ff_url_join(url, sizeof(url), "dtls", NULL, w->answer.cand_host, w->answer.cand_port, NULL);
+    av_dict_set_int(&opts, "mtu", WHEP_DTLS_MTU, 0);
+    av_dict_set(&opts, "cert_pem", w->cert_buf, 0);
+    av_dict_set(&opts, "key_pem", w->key_buf, 0);
+    av_dict_set_int(&opts, "external_sock", 1, 0);
+    av_dict_set_int(&opts, "use_srtp", 1, 0);
+    av_dict_set_int(&opts, "listen", 1, 0);
+    av_dict_set_int(&opts, "verify", 0, 0);      /* 对端自签名，信任来自指纹比对 */
+    ret = ffurl_open_whitelist(&w->dtls_uc, url, AVIO_FLAG_READ_WRITE, &cb,
+                               &opts, s->protocol_whitelist, s->protocol_blacklist, NULL);
+    av_dict_free(&opts);
+    if (ret < 0) {
+        av_log(s, AV_LOG_ERROR, "Cannot open DTLS: %s\n", av_err2str(ret));
+        return ret;
+    }
+    ff_tls_set_external_socket(w->dtls_uc, w->udp);
+    if ((ret = ffurl_handshake(w->dtls_uc)) < 0) {
+        av_log(s, AV_LOG_ERROR, "DTLS handshake failed: %s\n", av_err2str(ret));
+        return ret;
+    }
+#if CONFIG_OPENSSL
+    ret = ff_dtls_get_peer_fingerprint(w->dtls_uc, &peer_fp);
+#else
+    ret = AVERROR(ENOSYS);
+#endif
+    if (ret < 0) {
+        av_log(s, AV_LOG_ERROR, "Cannot get DTLS peer certificate fingerprint: %s\n", av_err2str(ret));
+        return ret;
+    }
+    if (strcmp(peer_fp, w->answer.fp)) {
+        av_log(s, AV_LOG_ERROR, "DTLS peer certificate fingerprint does not match the answer; refusing\n");
+        av_log(s, AV_LOG_VERBOSE, "answer=%s peer=%s\n", w->answer.fp, peer_fp);
+        av_free(peer_fp);
+        return AVERROR(EACCES);
+    }
+    av_free(peer_fp);
+    if (ff_dtls_export_materials(w->dtls_uc, (char *)w->srtp_materials, sizeof(w->srtp_materials)) < 0) {
+        av_log(s, AV_LOG_ERROR, "Cannot export SRTP keying material\n");
+        return AVERROR(EIO);
+    }
+    w->hs_deadline = INT64_MAX;      /* 握手期限只约束握手，之后的读写不再受它中断 */
+    av_log(s, AV_LOG_VERBOSE,
+           "DTLS done, peer fingerprint verified; SRTP keying material exported: %zu bytes, profile SRTP_AES128_CM_HMAC_SHA1_80, elapsed=%.1fms\n",
+           sizeof(w->srtp_materials), (av_gettime_relative() - w->t_start) / 1000.0);
+    return 0;
 }
 
