+/**
+ * ICE 连通性检查：周期性发请求（对端 ufrag/pwd），应答服务端的检查请求，
+ * 直到对端开始 DTLS（ClientHello 留在 socket 里不消费，用 MSG_PEEK 探测）。
+ * 超时、中断、socket 持续出错都干净返回。
+ * @return 0 表示可以开始 DTLS，负值失败
+ */
+static int whep_ice_connect(AVFormatContext *s)
+{
+    WHEPContext *w = s->priv_data;
+    uint8_t tid[12], buf[WHEP_UDP_BUF_SIZE], out[WHEP_UDP_BUF_SIZE];
+    int fd = ffurl_get_file_handle(w->udp), ice_ok = 0, ret, n;
+    int64_t next_tx = 0, now;
+
+    if ((ret = av_random_bytes(tid, sizeof(tid))) < 0 ||
+        (ret = av_random_bytes((uint8_t *)&w->ice_tie_breaker, sizeof(w->ice_tie_breaker))) < 0)
+        return ret;
+    for (;;) {
+        struct pollfd p = { .fd = fd, .events = POLLIN };
+
+        now = av_gettime_relative();
+        if (whep_handshake_interrupt(s)) {
+            ret = ff_check_interrupt(&s->interrupt_callback) ? AVERROR_EXIT : AVERROR(ETIMEDOUT);
+            av_log(s, AV_LOG_ERROR, "ICE %s (connectivity check %s)\n",
+                   ret == AVERROR(ETIMEDOUT) ? "timed out" : "interrupted",
+                   ice_ok ? "succeeded, no DTLS from peer" : "got no valid response");
+            return ret;
+        }
+        if (!ice_ok && now >= next_tx) {
+            if ((n = whep_ice_build_request(w, out, tid)) < 0)
+                return n;
+            if (ffurl_write(w->udp, out, n) < 0)
+                av_log(s, AV_LOG_DEBUG, "STUN request send failed, will retry\n");
+            next_tx = now + WHEP_ICE_RTX_US;
+        }
+        if (poll(&p, 1, 20) <= 0)
+            continue;
+        n = recv(fd, buf, sizeof(buf), MSG_PEEK);
+        if (n < 0) {
+            /* 例如对端端口不可达产生的 ICMP 错误：取走错误状态，稍等重试直到超时 */
+            recv(fd, buf, sizeof(buf), 0);
+            av_usleep(20000);
+            continue;
+        }
+        if (ff_is_dtls_packet(buf, n)) {
+            av_log(s, AV_LOG_VERBOSE, "ICE: peer started DTLS (check %s), elapsed=%.1fms\n",
+                   ice_ok ? "succeeded" : "response not seen", (now - w->t_start) / 1000.0);
+            return 0;
+        }
+        recv(fd, buf, sizeof(buf), 0);       /* 非 DTLS：取走处理或丢弃 */
+        if (n < STUN_HDR_SIZE || (buf[0] & 0xC0) || AV_RB32(buf + 4) != STUN_COOKIE)
+            continue;
+        if (AV_RB16(buf) == 0x0001) {
+            char user[300];
+            snprintf(user, sizeof(user), "%s:%s", w->ice_ufrag_local, w->answer.ufrag);
+            if (whep_stun_verify(buf, n, w->ice_pwd_local, user) &&
+                (n = whep_ice_build_response(w, out, buf + 8)) > 0)
+                ffurl_write(w->udp, out, n);
+        } else if (AV_RB16(buf) == 0x0101 && !memcmp(buf + 8, tid, 12) &&
+                   whep_stun_verify(buf, n, w->answer.pwd, NULL)) {
+            if (!ice_ok)
+                av_log(s, AV_LOG_VERBOSE, "ICE connectivity check succeeded, elapsed=%.1fms\n",
+                       (now - w->t_start) / 1000.0);
+            ice_ok = 1;
+        }
+    }
+}
