+/**
+ * 取 DTLS 握手后对端证书的 SHA-256 指纹（"AA:BB:.." 大写），供 WebRTC 与 SDP 指纹比对。
+ * @return 0 成功（*fingerprint 由调用方 av_free），负值：无对端证书/失败
+ */
+int ff_dtls_get_peer_fingerprint(URLContext *h, char **fingerprint)
+{
+    TLSContext *c = h->priv_data;
+    X509 *cert;
+    int ret;
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+    cert = SSL_get1_peer_certificate(c->ssl);
+#else
+    cert = SSL_get_peer_certificate(c->ssl);
+#endif
+    if (!cert)
+        return AVERROR(ENOENT);
+    ret = x509_fingerprint(cert, fingerprint);
+    X509_free(cert);
+    return ret;
+}
