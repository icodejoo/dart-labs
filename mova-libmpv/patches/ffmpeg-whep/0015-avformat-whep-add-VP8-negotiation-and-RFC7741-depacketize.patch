+#if WHEP_HAVE_VP8
+/* RFC 7741 payload descriptor / 返回长度，截断或非法 PartID 返回 -1。 */
+static int whep_vp8_desc(const uint8_t *p, int len, int *start)
+{
+    int n = 1;
+
+    if (len < 1 || (p[0] & 0x0f) > 8)
+        return -1;
+    if (p[0] & 0x80) {
+        int ext;
+        if (len < 2)
+            return -1;
+        ext = p[1];
+        n = 2;
+        if (ext & 0x80) {                         /* I: 7/15-bit PictureID */
+            if (n >= len)
+                return -1;
+            n += (p[n] & 0x80) ? 2 : 1;
+        }
+        if (ext & 0x40)                           /* L: TL0PICIDX */
+            n++;
+        if (ext & 0x30)                           /* T/K share one byte / 共用字节 */
+            n++;
+        if (n > len)
+            return -1;
+    }
+    *start = (p[0] & 0x10) && !(p[0] & 0x0f);
+    return n;
+}
+
+/* Complete frame only / 起播与丢包恢复均等待有效关键帧；无需 SPS/PPS。 */
+static void whep_vp8_au_end(AVFormatContext *s, WhepRx *rx)
+{
+    WHEPContext *w = s->priv_data;
+
+    if (!rx->au_open)
+        return;
+    rx->au_open = 0;
+    if (rx->au_bad || rx->au_size < 3) {
+        rx->n_drop_au++;
+        rx->seen_key = 0;
+    } else if (rx->au_key &&
+               (rx->au_size < 10 || AV_RB24(rx->au + 3) != 0x9d012a ||
+                !(AV_RL16(rx->au + 6) & 0x3fff) || !(AV_RL16(rx->au + 8) & 0x3fff))) {
+        rx->n_drop_au++;
+        rx->seen_key = 0;
+    } else if (!rx->seen_key && !rx->au_key) {
+        rx->n_nokey++;
+    } else {
+        if (!rx->seen_key) {
+            AVCodecParameters *par = s->streams[rx->stream_index]->codecpar;
+            par->width  = AV_RL16(rx->au + 6) & 0x3fff;
+            par->height = AV_RL16(rx->au + 8) & 0x3fff;
+            av_log(s, AV_LOG_VERBOSE, "First video key frame out at %.1fms since open (pli_sent=%"PRIu64") size=%dx%d\n",
+                   (av_gettime_relative() - w->t_start) / 1000.0, rx->n_pli, par->width, par->height);
+            rx->seen_key = 1;
+        }
+        whep_rx_emit(s, rx, rx->au, rx->au_size, rx->au_pts, rx->au_key, 0);
+    }
+    rx->au_size = 0;
+}
+
+/* RFC 7741 reassembly / 只有 marker 才结束完整帧；时间戳跳变表示上一帧缺尾。 */
+static void whep_vp8_input(AVFormatContext *s, WhepRx *rx, const uint8_t *p, int len,
+                           uint32_t ts, int64_t pts, int marker)
+{
+    int start = 0, desc;
+
+    if (rx->au_open && ts != rx->au_ts) {
+        rx->au_bad = 1;
+        whep_vp8_au_end(s, rx);
+    }
+    if (!rx->au_open) {
+        rx->au_open = 1;
+        rx->au_ts   = ts;
+        rx->au_pts  = pts;
+        rx->au_size = 0;
+        rx->au_key  = 0;
+        rx->au_bad  = 0;
+    }
+    desc = whep_vp8_desc(p, len, &start);
+    if (desc < 0 || desc >= len) {
+        rx->au_bad = 1;
+    } else if (start) {
+        if (rx->au_size)
+            rx->au_bad = 1;                       /* Duplicate start / 重复帧起点 */
+        rx->au_key = !(p[desc] & 1);
+        whep_h264_add(rx, p + desc, len - desc, 0);
+    } else if (!rx->au_size) {
+        rx->au_bad = 1;                           /* Missing start / 起始包丢失 */
+    } else {
+        whep_h264_add(rx, p + desc, len - desc, 0);
+    }
+    if (marker)
+        whep_vp8_au_end(s, rx);
+}
