From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mova <mova@example.invalid>
Date: Fri, 2 Oct 2026 15:35:36 +0800
Subject: [PATCH 1/3] avformat: register whep demuxer, off by default

---
 configure                | 4 ++++
 libavformat/Makefile     | 1 +
 libavformat/allformats.c | 1 +
 3 files changed, 6 insertions(+)

diff --git a/configure b/configure
index 374bd5c..10902ab 100755
--- a/configure
+++ b/configure
@@ -4011,6 +4011,7 @@ wav_demuxer_select="riffdec"
 wav_muxer_select="riffenc"
 webm_chunk_muxer_select="webm_muxer"
 webm_dash_manifest_demuxer_select="matroska_demuxer"
+whep_demuxer_select="dtls_protocol http_protocol srtp"
 whip_muxer_select="dtls_protocol rtp_muxer http_protocol"
 wtv_demuxer_select="mpegts_demuxer riffdec"
 wtv_muxer_select="mpegts_muxer riffenc"
@@ -4626,6 +4627,9 @@ done
 
 enable $ARCH_EXT_LIST
 
+# whep demuxer is opt-in: off unless --enable-demuxer=whep is given
+disable whep_demuxer
+
 die_unknown(){
     echo "Unknown option \"$1\"."
     echo "See $0 --help for available options."
diff --git a/libavformat/Makefile b/libavformat/Makefile
index 0d2e757..db8827f 100644
--- a/libavformat/Makefile
+++ b/libavformat/Makefile
@@ -642,6 +642,7 @@ OBJS-$(CONFIG_WAVARC_DEMUXER)            += wavarc.o
 OBJS-$(CONFIG_WAV_DEMUXER)               += wavdec.o pcm.o
 OBJS-$(CONFIG_WAV_MUXER)                 += wavenc.o
 OBJS-$(CONFIG_WC3_DEMUXER)               += wc3movie.o
+OBJS-$(CONFIG_WHEP_DEMUXER)               += whep.o
 OBJS-$(CONFIG_WEBM_MUXER)                += matroskaenc.o matroska.o \
                                             avlanguage.o
 OBJS-$(CONFIG_WEBM_DASH_MANIFEST_MUXER)  += webmdashenc.o
diff --git a/libavformat/allformats.c b/libavformat/allformats.c
index af7eea5..deca5ed 100644
--- a/libavformat/allformats.c
+++ b/libavformat/allformats.c
@@ -511,6 +511,7 @@ extern const FFInputFormat  ff_wavarc_demuxer;
 extern const FFInputFormat  ff_wav_demuxer;
 extern const FFOutputFormat ff_wav_muxer;
 extern const FFInputFormat  ff_wc3_demuxer;
+extern const FFInputFormat  ff_whep_demuxer;
 extern const FFOutputFormat ff_webm_muxer;
 extern const FFInputFormat  ff_webm_dash_manifest_demuxer;
 extern const FFOutputFormat ff_webm_dash_manifest_muxer;
