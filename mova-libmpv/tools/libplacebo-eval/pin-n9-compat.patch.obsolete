diff --git a/common/av_compat.h b/common/av_compat.h
new file mode 100644
index 0000000000..b7d5e7d31d
--- /dev/null
+++ b/common/av_compat.h
@@ -0,0 +1,8 @@
+#pragma once
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+/* ffmpeg>=7.1 removed AVCodec.{sample_fmts,pix_fmts,...}; shim via avcodec_get_supported_config */
+static inline const void *mp_codec_cfg(const AVCodec *c, enum AVCodecConfig t)
+{ const void *o = NULL; avcodec_get_supported_config(NULL, c, t, 0, &o, NULL); return o; }
+static inline uint8_t *mp_st_sd(AVStream *st, enum AVPacketSideDataType t)
+{ const AVPacketSideData *s = av_packet_side_data_get(st->codecpar->coded_side_data, st->codecpar->nb_coded_side_data, t); return s ? s->data : NULL; }
