+
+# mova's own trimmed audio component list (mirrors mova-libmpv/
+# flavors-mova-slim.sh's Android DECODERS_AUDIO/PARSERS/DEMUXERS — same
+# reasoning as video_movaslim_options above: audio_default_options below
+# drops in every legacy/niche codec ffmpeg knows (DTS/TrueHD/AC3/EAC3/WMA*/
+# APE/ATRAC*/ALS/GSM*/MPC*/RA*/Shorten/TAK/TTA/WavPack/DSD*/mp1/mp2 decoders,
+# plus asf/avi/rm/aiff/au/wv/xwma/dsf/dts/truehd demuxers) that mova's HLS/
+# MP4 VOD+live pipeline never produces — none of mova's ad/live/VOD sources
+# carry them, and each one is a dylib-size line item for a codec that never
+# gets exercised. Keeps: AAC (HLS/MP4 default audio), MP3, Opus, FLAC,
+# Vorbis (ogg/webm audio) and raw/linear PCM (wav, and some mp4 sources).
+# Demuxers add mp3/flac/ogg/wav/aac on top of video_movaslim_options' mov/
+# matroska/mpegts/hls so mova's audioOnly mode (0.4.x, see mova/CLAUDE.md)
+# can also open a bare standalone audio file, not just audio-in-video.
+audio_movaslim_options = [
+    # decoders
+    '--enable-decoder=aac',
+    '--enable-decoder=aac_latm',
+    '--enable-decoder=mp3float',
+    '--enable-decoder=opus',
+    '--enable-decoder=flac',
+    '--enable-decoder=vorbis',
+    '--enable-decoder=pcm_s16le',
+    '--enable-decoder=pcm_s16be',
+    '--enable-decoder=pcm_s24le',
+    '--enable-decoder=pcm_s32le',
+    '--enable-decoder=pcm_f32le',
+    '--enable-decoder=pcm_u8',
+
+    # parsers
+    '--enable-parser=aac',
+    '--enable-parser=aac_latm',
+    '--enable-parser=flac',
+    '--enable-parser=opus',
+    '--enable-parser=vorbis',
+    '--enable-parser=mpegaudio', # mp3
+
+    # demuxers — standalone audio containers only; mov/matroska/mpegts/hls
+    # (audio-in-video) already come from video_movaslim_options above
+    '--enable-demuxer=mp3',
+    '--enable-demuxer=flac',
+    '--enable-demuxer=ogg',
+    '--enable-demuxer=wav',
+    '--enable-demuxer=aac',
