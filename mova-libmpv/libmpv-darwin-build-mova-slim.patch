diff --git a/nix/packages/mk-pkg-ffmpeg/meson.build b/nix/packages/mk-pkg-ffmpeg/meson.build
index 35457c2..b81f530 100644
--- a/nix/packages/mk-pkg-ffmpeg/meson.build
+++ b/nix/packages/mk-pkg-ffmpeg/meson.build
@@ -46,8 +46,6 @@ common_options = [
     '--enable-network',
     '--enable-pthreads',
     '--enable-pic',
-    '--enable-mbedtls', # tls support (mbedtls)
-    '--enable-version3',
     '--enable-safe-bitstream-reader',
     '--enable-stripping',
     '--enable-avcodec',
@@ -60,6 +58,22 @@ common_options = [
     # '--enable-nonfree', # uncomment it to include unredistributable code
 ]
 
+# TLS backend: split out from common_options so mova's movaslim flavor can
+# swap mbedtls for Apple's system TLS (securetransport) — drops 3 dylibs
+# (libmbedtls/libmbedx509/libmbedcrypto from the mk-out-libs bundle) and the
+# --enable-version3 requirement mbedtls's dual Apache/GPL-2.0 licensing
+# forces (same reasoning as mova's Linux/Windows flavors, which made the
+# same swap to openssl/SChannel — see mova-libmpv/README.md).
+tls_default_options = [
+    '--enable-mbedtls', # tls support (mbedtls)
+    '--enable-version3',
+]
+
+tls_movaslim_options = [
+    '--enable-securetransport', # Apple's own TLS (Security.framework) — no
+                                 # extra dylib to ship, no version3 bump
+]
+
 audio_common_options = [
     '--enable-zlib', # rasc support
     '--enable-audiotoolbox',
@@ -67,11 +81,87 @@ audio_common_options = [
 
 video_common_options = [
     '--enable-neon', # improve hevc (h265) support on arm
-    '--enable-libxml2', # dash support
     '--enable-videotoolbox',
     '--enable-libdav1d', # av1 support
 ]
 
+# dash support (libxml2) is its own toggle: mova's movaslim flavor doesn't
+# need the dash demuxer, and libxml2.dylib is one of the largest deps in the
+# mk-out-libs bundle (~2MiB) — see mk-out-libs/default.nix's matching skip.
+video_dash_options = [
+    '--enable-libxml2', # dash support
+]
+
+# mova's own trimmed video component list (mirrors mova-libmpv/
+# flavors-mova-slim-ios.sh's DECODERS/ENCODERS/PARSERS/DEMUXERS/BSFS — that
+# script targeted a plain autotools build and is now orphaned by the switch
+# to this Nix+meson pipeline, but its component *values* are what mova
+# actually wants and are ported here unchanged). Deliberately narrower than
+# video_default_options above: no flv/h263/mpeg1/mpeg2/mpeg4/vp6/vp8/theora/
+# msmpeg4/wmv/mjpeg legacy-codec support, no dvbsub/dvdsub/pgssub image
+# subtitle decoders — mova only targets modern VOD/live (h264/hevc/vp9/av1
+# video, text-based subtitle formats).
+video_movaslim_options = [
+    # decoders
+    '--enable-decoder=h264',
+    '--enable-decoder=hevc',
+    '--enable-decoder=vp9',
+    '--enable-decoder=libdav1d', # av1 via dav1d only, no native av1 decoder
+    '--enable-decoder=png',
+    '--enable-decoder=ssa',
+    '--enable-decoder=ass',
+    '--enable-decoder=srt',
+    '--enable-decoder=subrip',
+    '--enable-decoder=text',
+    '--enable-decoder=webvtt',
+    '--enable-decoder=movtext',
+
+    # encoders
+    '--enable-encoder=png',
+
+    # parsers
+    '--enable-parser=h264',
+    '--enable-parser=hevc',
+    '--enable-parser=vp9',
+    '--enable-parser=av1',
+    '--enable-parser=png',
+
+    # demuxers
+    '--enable-demuxer=mov',
+    '--enable-demuxer=matroska',
+    '--enable-demuxer=webm_dash_manifest',
+    '--enable-demuxer=mpegts',
+    '--enable-demuxer=hls',
+    '--enable-demuxer=flv',
+    '--enable-demuxer=live_flv',
+    '--enable-demuxer=data',
+    '--enable-demuxer=ass',
+    '--enable-demuxer=srt',
+    '--enable-demuxer=webvtt',
+
+    # bitstream filters (default/full flavors above enable none individually
+    # — "full" only turns them on in bulk via --enable-bsfs; movaslim opts
+    # into just the ones mova's remux/seek paths need)
+    '--enable-bsf=null',
+    '--enable-bsf=extract_extradata',
+    '--enable-bsf=h264_mp4toannexb',
+    '--enable-bsf=hevc_mp4toannexb',
+    '--enable-bsf=aac_adtstoasc',
+    '--enable-bsf=vp9_superframe',
+    '--enable-bsf=vp9_superframe_split',
+    '--enable-bsf=av1_frame_split',
+    '--enable-bsf=av1_frame_merge',
+    '--enable-bsf=mov2textsub',
+    '--enable-bsf=dump_extradata',
+    '--enable-bsf=setts',
+
+    # hwaccels — only h264/hevc have a VideoToolbox hwaccel in this ffmpeg
+    # version; vp9/av1 stay software-only via libdav1d (same real capability
+    # gap flavors-mova-slim-ios.sh documented, not an oversight here either)
+    '--enable-hwaccel=h264_videotoolbox',
+    '--enable-hwaccel=hevc_videotoolbox',
+]
+
 # https://github.com/media-kit/libmpv-android-audio-build/blob/260666c0fef8c154971b5faf3f78da27c2bf2c40/buildscripts/flavors/default.sh
 audio_default_options = [
     # decoders
@@ -303,9 +393,19 @@ options = disable_all_options
 
 # common
 options += common_options
+if flavor == 'movaslim'
+    options += tls_movaslim_options
+else
+    options += tls_default_options
+endif
 options += audio_common_options
 if variant == 'video'
     options += video_common_options
+    # movaslim skips the dash demuxer/libxml2 dependency entirely (see
+    # video_dash_options's comment) — every other flavor keeps it.
+    if flavor != 'movaslim'
+        options += video_dash_options
+    endif
 endif
 
 # components
@@ -326,6 +426,14 @@ elif flavor == 'encodersgpl'
         options += video_full_options
         options += video_encodersgpl_options
     endif
+elif flavor == 'movaslim'
+    # audio path is untouched (mova's slimming work so far is video-only —
+    # flavors-mova-slim-ios.sh never touched the audio variant either);
+    # reuse audio_default_options as-is.
+    options += audio_default_options
+    if variant == 'video'
+        options += video_movaslim_options
+    endif
 endif
 
 p = mod.add_project('configure',
diff --git a/nix/packages/mk-pkg-ffmpeg/meson.options b/nix/packages/mk-pkg-ffmpeg/meson.options
