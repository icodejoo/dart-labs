+# TLS backend: split out from common_options so mova's movaslim flavor can
+# swap mbedtls for Apple's system TLS (securetransport) — drops 3 dylibs
+# (libmbedtls/libmbedx509/libmbedcrypto from the mk-out-libs bundle) and the
+# --enable-version3 requirement mbedtls's dual Apache/GPL-2.0 licensing
+# forces (same reasoning as mova's Linux/Windows flavors, which made the
+# same swap to openssl/SChannel — see mova-libmpv/README.md).
+# Linking mode: every flavor except movaslim ships ffmpeg as its own
+# separate .dylib (shared, dynamically linked by mpv and bundled alongside
+# it — see mk-out-libs/default.nix). movaslim instead builds ffmpeg
+# static-only (no .dylib at all) so mpv can fold it directly into the one
+# libmpv.dylib mova ships, matching Android's single-.so shape and avoiding
+# the per-dylib overhead (headers, exported symbol tables, load-time
+# indirection) of several separate shared libraries.
+linking_default_options = [
+    '--enable-shared',
+]
+
+linking_movaslim_options = [
+    '--enable-static',
+    '--disable-shared',
+]
+
+tls_default_options = [
+    '--enable-mbedtls', # tls support (mbedtls)
+    '--enable-version3',
+]
+
+tls_movaslim_options = [
+    '--enable-securetransport', # Apple's own TLS (Security.framework) — no
+                                 # extra dylib to ship, no version3 bump
+]
+
 audio_common_options = [
     '--enable-zlib', # rasc support
     '--enable-audiotoolbox',
@@ -67,11 +106,175 @@ audio_common_options = [
 
 video_common_options = [
     '--enable-neon', # improve hevc (h265) support on arm
-    '--enable-libxml2', # dash support
     '--enable-videotoolbox',
     '--enable-libdav1d', # av1 support
