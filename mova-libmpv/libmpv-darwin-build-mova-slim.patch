diff --git a/nix/utils/constants/flavors.nix b/nix/utils/constants/flavors.nix
index e2aa737..ac4fa51 100644
--- a/nix/utils/constants/flavors.nix
+++ b/nix/utils/constants/flavors.nix
@@ -2,4 +2,10 @@
   default = "default";
   full = "full";
   encodersgpl = "encodersgpl";
+  # mova's own decoder/demuxer/parser slim list (video variant only —
+  # audio_default_options is reused as-is) plus securetransport instead of
+  # mbedtls for TLS (drops 3 dylibs + the --enable-version3 GPLv3-adjacent
+  # requirement, mirroring mova/tools/ffmpeg-slim's already-designed but
+  # never-wired-up flavors-mova-slim-ios.sh).
+  movaslim = "movaslim";
 }
