+video_movaslim_options = [
+    # decoders
+    '--enable-decoder=h264',
+    '--enable-decoder=hevc',
+    '--enable-decoder=vp9',
+    '--enable-decoder=libdav1d', # av1 via dav1d only, no native av1 decoder
+    '--enable-decoder=png',
+    '--enable-decoder=ssa',
+    '--enable-decoder=ass',
+    '--enable-decoder=srt',
+    '--enable-decoder=subrip',
+    '--enable-decoder=text',
+    '--enable-decoder=webvtt',
+    '--enable-decoder=movtext',
+
+    # encoders
+    '--enable-encoder=png',
+
+    # parsers
+    '--enable-parser=h264',
+    '--enable-parser=hevc',
+    '--enable-parser=vp9',
+    '--enable-parser=av1',
+    '--enable-parser=png',
+
+    # demuxers
+    '--enable-demuxer=mov',
+    '--enable-demuxer=matroska',
+    # webm_dash_manifest dropped (2026-09-18): mova confirmed it doesn't
+    # need WebM adaptive-bitrate manifest playback (DASH sources are rare
+    # for mova and, where they exist, aren't WebM-manifest-based) — unlike
+    # Android's flavors-mova-slim.sh, which still carries it from before
+    # this was reassessed; not backported there to avoid re-triggering
+    # that already-verified, already-shipped config's real-device
+    # regression testing over a demuxer mova doesn't actually use.
+    '--enable-demuxer=mpegts',
+    '--enable-demuxer=hls',
+    '--enable-demuxer=flv',
+    '--enable-demuxer=live_flv',
+    '--enable-demuxer=data',
+    '--enable-demuxer=ass',
+    '--enable-demuxer=srt',
+    '--enable-demuxer=webvtt',
+
